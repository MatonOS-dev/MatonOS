cc_binary {
    name: "matonos-mountd",
    srcs: [
        "mountd_core.c",
        "mountd_main.cpp",
    ],
    local_include_dirs: ["."],
    shared_libs: [
        "libbinder_ndk",
        "libjsoncpp",
        "liblog",
        "vendor.matonos.channel-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-D_FILE_OFFSET_BITS=64",
    ],
    cppflags: [
        "-Wall",
        "-Werror",
        "-std=c++20",
    ],
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["matonos-mountd.rc"],
}
