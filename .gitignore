# --- generic build outputs, caches, secrets (anywhere below) ---
node_modules/
build/
.gradle/
.cxx/
.kotlin/
.expo/
.metro-health-check*
*.apk
*.aab
*.jks
*.keystore
*.pass
*.pk8
local.properties
framework-stubs.jar
*.log
.DS_Store
matonos.local.env

# --- Expo CNG: android/ is generated by `expo prebuild` ---
/rn-apps/*/android/

# --- staged binaries and downloads (rebuilt/fetched by tools/) ---
/prebuilt/
/apps/apks/
/buildinfra/apps-built/
/buildinfra/native-built/
/bootanim/out/
/bootwatch/out/
/tools/payload/
/audio/native-hal/deps/
/**/libs/*.jar

# --- pristine upstream sources for the Linux-apps stack (fetched, not committed) ---
/linux/third_party/*/upstream/

# Private signing keys never go into this public repo
*.pem
*.pk8
