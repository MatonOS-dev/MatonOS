# Vendor init for pc_x86_64. Installed as /vendor/etc/init/hw/init.pc_x86_64.rc
# (ro.hardware comes from androidboot.hardware=pc_x86_64 on the cmdline).
#
# Kernel modules (GPU, NIC, ...) in /vendor/lib/modules are loaded by ueventd
# via modalias matching (see ueventd.rc); storage drivers are built in.

on fs
    # Mount everything that does not require fsck
    mount_all --early

on late-fs
    # Mount RW partitions which need fsck (userdata)
    mount_all --late

on post-fs-data
    mkdir /data/vendor/var 0755 root root

# zram swap (zramsize in the fstab, 100% of RAM; zstd for its ratio, PC CPUs
# absorb the cost; user, 2026-09-26). Enabled after boot completes so it
# never delays boot.
on property:sys.boot_completed=1
    write /sys/block/zram0/comp_algorithm zstd
    # zram is the only swap: favour compressing idle anon pages over dropping
    # file cache (user, 2026-11-24).
    write /proc/sys/vm/swappiness 180
    swapon_all

on property:ro.debuggable=1
    # adb over TCP for VM / headless bring-up. PCs have no USB gadget, so
    # nothing else starts adbd; authentication stays on (ro.adb.secure).
    setprop service.adb.tcp.port 5555
    start adbd

# Keyboards (and the USB path above them) as s2idle wake sources.
service vendor.pc-wakeup /vendor/bin/pc-wakeup.sh
    class core
    user root
    group root
    oneshot
    disabled

on boot
    start vendor.pc-wakeup

# Android's suspend service must retain wake-lock APIs, but never the kernel
# suspend control. Stock main.cpp falls back to socketpair FDs when state
# cannot be opened; both autosuspend and forceSuspend then cannot suspend.
# Platform on-init permissions run first; early_hal starts later at boot.
on init
    # Like systemd: no system-wide open-file cap. The compat-proxy serves this
    # exact value to Linux apps (linux/compat-proxy/proxy.c) - keep them in sync.
    write /proc/sys/fs/file-max 9223372036854775807
    chown root root /sys/power/state
    chmod 0600 /sys/power/state
    chown root root /sys/power/wakeup_count
    chmod 0600 /sys/power/wakeup_count
    write /sys/power/autosleep off
    chown root root /sys/power/autosleep
    chmod 0600 /sys/power/autosleep

# Stock on-boot assigns autosleep to system: take it back after that action.
on boot
    chown root root /sys/power/autosleep
    chmod 0600 /sys/power/autosleep

# audioapex1: activate the pre-packaged audio services only after data and
# APEX activation; failures stay asynchronous and never hold up boot.
on post-fs-data && property:ro.vendor.matonos.audio.pipewire=true
    mkdir /data/vendor/maton-audio 0770 audio audio
    mkdir /data/vendor/maton-audio/state 0770 audio audio
    start vendor.pipewire
    start vendor.audio-effect-hal-aidl

on property:init.svc.vendor.pipewire=running
    start vendor.wireplumber
    start vendor.audio-hal-aidl
