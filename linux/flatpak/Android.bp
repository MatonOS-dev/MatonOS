apex_key {
    name: "com.matonos.flatpak.key",
    public_key: "com.matonos.flatpak.avbpubkey",
    private_key: "com.matonos.flatpak.pem",
}

apex {
    name: "com.matonos.flatpak",
    manifest: "apex_manifest.json",
    key: "com.matonos.flatpak.key",
    file_contexts: "apex_file_contexts",
    system_ext_specific: true,
    compile_multilib: "64",
    updatable: true,
    min_sdk_version: "37",
    binaries: [
        "matonos-flatpak-static-prebuilt",
        "matonos-flatpak-launcher-static-prebuilt",
        "matonos-bwrap-static-prebuilt",
        "matonos-app-exec-static-prebuilt",
        "matonos-flatpak-store-static-prebuilt",
    ],
    prebuilts: [
        "matonos-flatpak-flathub-key",
        "matonos-flatpak-flathub-remote",
        "matonos-flatpak-license-dullpgp-txt",
        "matonos-flatpak-license-licenses-md",
        "matonos-flatpak-license-notice",
        "matonos-flatpak-license-boringssl-txt",
        "matonos-flatpak-license-bubblewrap-txt",
        "matonos-flatpak-license-bzip2-txt",
        "matonos-flatpak-license-curl-txt",
        "matonos-flatpak-license-flatpak-txt",
        "matonos-flatpak-license-gcc-libgcc-txt",
        "matonos-flatpak-license-gcc-libstdc-txt",
        "matonos-flatpak-license-gettext-libintl-txt",
        "matonos-flatpak-license-glib-txt",
        "matonos-flatpak-license-json-glib-txt",
        "matonos-flatpak-license-libarchive-txt",
        "matonos-flatpak-license-libcap-txt",
        "matonos-flatpak-license-libeconf-txt",
        "matonos-flatpak-license-libffi-txt",
        "matonos-flatpak-license-libseccomp-txt",
        "matonos-flatpak-license-libxml2-txt",
        "matonos-flatpak-license-linked-components-json",
        "matonos-flatpak-license-lz4-txt",
        "matonos-flatpak-license-musl-txt",
        "matonos-flatpak-license-ostree-txt",
        "matonos-flatpak-license-pcre2-txt",
        "matonos-flatpak-license-util-linux-libs-txt",
