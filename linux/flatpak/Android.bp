package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Static musl stack produced by MatonOS-dev/MatonOS_apexs. Its executable
// has applet dispatch for Flatpak, OSTree and bubblewrap. Soong drops
// prebuilt-binary symlinks in APEX payloads, so callers set argv[0] to select
// the applet while executing this one ELF by its real filename.
cc_prebuilt_binary {
    name: "matonos-flatpak-static-prebuilt",
    srcs: ["prebuilt/static/x86_64/matonos-flatpak"],
    stem: "matonos-flatpak",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

// The namespace entrypoint remains a normal Android process. It prepares
// the host-side launch handoff before the static stack creates its musl root.
cc_binary {
    name: "matonos-flatpak-launcher",
    srcs: ["flatpak-env-wrapper.c"],
    local_include_dirs: ["."],
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    min_sdk_version: "37",
    compile_multilib: "64",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-D_GNU_SOURCE",
    ],
    stem: "flatpak-env-wrapper",
}

// These two launch-chain helpers execute after entering the musl-only root.
// Stage stripped static-musl files alongside the multicall payload. Their
// canonical sources remain in this directory; prebuilt/static/SOURCE records
// source and artifact hashes.
cc_prebuilt_binary {
    name: "matonos-bwrap-static-prebuilt",
    srcs: ["prebuilt/static/x86_64/matonos-bwrap"],
    stem: "matonos-bwrap",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

cc_prebuilt_binary {
    name: "matonos-app-exec-static-prebuilt",
    srcs: ["prebuilt/static/x86_64/matonos-app-exec"],
    stem: "matonos-app-exec",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

prebuilt_etc {
    name: "matonos-flatpak-flathub-key",
    src: "etc/flatpak/flathub.gpg",
    filename: "flathub.gpg",
    sub_dir: "flatpak",
    installable: false,
}

prebuilt_etc {
    name: "matonos-flatpak-flathub-remote",
    src: "etc/flatpak/remotes.d/flathub.flatpakrepo",
    filename: "flathub.flatpakrepo",
    sub_dir: "flatpak/remotes.d",
    installable: false,
}

apex_key {
    name: "com.matonos.flatpak.key",
    public_key: "com.matonos.flatpak.avbpubkey",
    private_key: "com.matonos.flatpak.pem",
}

apex {
    name: "com.matonos.flatpak",
    manifest: "apex_manifest.json",
    key: "com.matonos.flatpak.key",
    file_contexts: "apex_file_contexts",
    system_ext_specific: true,
    compile_multilib: "64",
    updatable: true,
    min_sdk_version: "37",
    binaries: [
        "matonos-flatpak-static-prebuilt",
        "matonos-flatpak-launcher",
        "matonos-bwrap-static-prebuilt",
        "matonos-app-exec-static-prebuilt",
        "matonos-flatpak-store",
    ],
    prebuilts: [
        "matonos-flatpak-flathub-key",
        "matonos-flatpak-flathub-remote",
    ],
}
