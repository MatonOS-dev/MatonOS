package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Static musl stack produced by MatonOS-dev/MatonOS_apexs. Its executable
// has applet dispatch for Flatpak, OSTree and bubblewrap. Soong drops
// prebuilt-binary symlinks in APEX payloads, so callers set argv[0] to select
// the applet while executing this one ELF by its real filename.
cc_prebuilt_binary {
    name: "matonos-flatpak-static-prebuilt",
    srcs: ["prebuilt/static/x86_64/matonos-flatpak"],
    stem: "matonos-flatpak",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

// The launch-chain helpers are all stripped static-musl prebuilts staged by
// stage-static-musl.sh. Source and artifact hashes are in prebuilt/static/SOURCE.
cc_prebuilt_binary {
    name: "matonos-bwrap-static-prebuilt",
    srcs: ["prebuilt/static/x86_64/matonos-bwrap"],
    stem: "matonos-bwrap",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

cc_prebuilt_binary {
    name: "matonos-flatpak-launcher-static-prebuilt",
    srcs: ["prebuilt/static/x86_64/flatpak-env-wrapper"],
    stem: "flatpak-env-wrapper",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

cc_prebuilt_binary {
    name: "matonos-flatpak-store-static-prebuilt",
    srcs: ["prebuilt/static/x86_64/matonos-flatpak-store"],
    stem: "matonos-flatpak-store",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

cc_prebuilt_binary {
    name: "matonos-app-exec-static-prebuilt",
    srcs: ["prebuilt/static/x86_64/matonos-app-exec"],
    stem: "matonos-app-exec",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

prebuilt_etc {
    name: "matonos-flatpak-flathub-key",
    src: "etc/flatpak/flathub.gpg",
    filename: "flathub.gpg",
    sub_dir: "flatpak",
    installable: false,
}

prebuilt_etc {
    name: "matonos-flatpak-flathub-remote",
    src: "etc/flatpak/remotes.d/flathub.flatpakrepo",
    filename: "flathub.flatpakrepo",
    sub_dir: "flatpak/remotes.d",
    installable: false,
}

