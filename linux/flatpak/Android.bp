package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ============================================================================
// MatonOS Flatpak stack — one updatable APEX (com.matonos.flatpak, r24)
//
// The APEX is preinstalled on system_ext
// (/system_ext/apex/com.matonos.flatpak.apex) and mounts at
// /apex/com.matonos.flatpak. Everything Flatpak runs from is inside it; the
// only thing that stays in system_ext is linuxd, which execs paths under the
// APEX. See linux/flatpak/APEX.md for the build/update/versioning procedure.
//
// The binaries and libraries below that are built out-of-tree (the NDK
// Flatpak/GPG stack: linux/flatpak/prebuilt/system_ext) are wrapped as
// cc_prebuilt_binary / cc_prebuilt_library_shared so they land in the APEX
// bin/ and lib64/ with that APEX's linker namespace. No LD_LIBRARY_PATH is
// needed: linkerconfig generates the `com.matonos.flatpak` namespace from the
// APEX itself (see APEX.md, "Linker namespace").
// ============================================================================

cc_defaults {
    name: "matonos_flatpak_apex_defaults",
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    // These are third-party prebuilts: do not re-validate DT_NEEDED/SONAME.
    check_elf_files: false,
}

// ---------------------------------------------------------------- Soong-built

// MatonOS bwrap shim: binds the per-app X11 relay socket
// into the Flatpak sandbox. Launched as $FLATPAK_BWRAP by
// flatpak-env-wrapper.c; see flatpak.mk.
cc_binary {
    name: "matonos-bwrap",
    srcs: [
        "matonos-bwrap.c",
    ],
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    // APEX payload modules must support the APEX's min_sdk_version (37).
    min_sdk_version: "37",
    compile_multilib: "64",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

// r24 payload entry: bwrap execs this tiny launcher, which dyntransitions to
// the app sandbox domain and execs the verified payload. See
// install/linuxd/CODE-STORAGE-r24.md and the exec chain in matonos-bwrap.c.
cc_binary {
    name: "matonos-app-exec",
    srcs: [
        "matonos-app-exec.c",
    ],
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    // APEX payload modules must support the APEX's min_sdk_version (37).
    min_sdk_version: "37",
    compile_multilib: "64",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

// r24 privileged mount helper: the only holder of CAP_SYS_ADMIN on the app
// launch path. It setns()es into the sandbox mount namespace and mounts the
// verified code image/volume from outside. Exec'd by flatpak-env-wrapper.c.
cc_binary {
    name: "matonos-mount-helper",
    srcs: [
        "matonos-mount-helper.c",
    ],
    system_ext_specific: true,
    apex_available: ["com.matonos.flatpak"],
    // APEX payload modules must support the APEX's min_sdk_version (37).
    min_sdk_version: "37",
    compile_multilib: "64",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

// ------------------------------------------------------- out-of-tree prebuilts

// The Flatpak launcher (flatpak-env-wrapper.c) is compiled by
// tools/build-native.sh and staged in prebuilt/system_ext/bin/flatpak.
cc_prebuilt_binary {
    name: "matonos-flatpak-launcher-prebuilt",
    defaults: ["matonos_flatpak_apex_defaults"],
    srcs: ["prebuilt/system_ext/bin/flatpak"],
    stem: "flatpak",
}

cc_prebuilt_binary {
    name: "matonos-flatpak-cli-prebuilt",
    defaults: ["matonos_flatpak_apex_defaults"],
    srcs: ["prebuilt/system_ext/bin/matonos-flatpak"],
    stem: "matonos-flatpak",
}

cc_prebuilt_binary {
