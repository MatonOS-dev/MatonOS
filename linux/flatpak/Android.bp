// Flatpak runtime triggers, installed under usr/share (Flatpak's datadir is
// compiled to /apex/com.matonos.flatpak/usr/share; see build-seccomp.sh and
// APEX.md).
prebuilt_usr_share {
    name: "matonos-flatpak-trigger-desktop-database",
    src: "prebuilt/system_ext/share/flatpak/triggers/desktop-database.trigger",
    filename_from_src: true,
    sub_dir: "flatpak/triggers",
    installable: false,
}

prebuilt_usr_share {
    name: "matonos-flatpak-trigger-gtk-icon-cache",
    src: "prebuilt/system_ext/share/flatpak/triggers/gtk-icon-cache.trigger",
    filename_from_src: true,
    sub_dir: "flatpak/triggers",
    installable: false,
}

prebuilt_usr_share {
    name: "matonos-flatpak-trigger-mime-database",
    src: "prebuilt/system_ext/share/flatpak/triggers/mime-database.trigger",
    filename_from_src: true,
    sub_dir: "flatpak/triggers",
    installable: false,
}

// ---------------------------------------------------------------- key + APEX

// Repository development key. The release build MUST replace both files with
// the MatonOS release APEX key (see APEX.md, "Keys"): a release APEX can only
// be updated by an APEX signed with the same key, so the dev key is for
// adb install / bring-up only.
apex_key {
    name: "com.matonos.flatpak.key",
    public_key: "com.matonos.flatpak.avbpubkey",
    private_key: "com.matonos.flatpak.pem",
}

apex {
    name: "com.matonos.flatpak",
    manifest: "apex_manifest.json",
    key: "com.matonos.flatpak.key",
    file_contexts: "apex_file_contexts",
    system_ext_specific: true,
    compile_multilib: "64",
    updatable: true,
    // Android 17 / API 37: first SDK that ships this APEX.
    min_sdk_version: "37",

    binaries: [
        // Soong-built.
        "bwrap",
        "matonos-bwrap",
        "matonos-app-exec",
        "matonos-mount-helper",
        // install/linuxd/FlatpakStore.c, built next to linuxd but shipped here.
        "matonos-flatpak-store",
        // NDK prebuilts.
        "matonos-flatpak-launcher-prebuilt",
        "matonos-flatpak-cli-prebuilt",
        "matonos-flatpak-portal-prebuilt",
        "matonos-flatpak-gpg-prebuilt",
        "matonos-flatpak-ostree-prebuilt",
        "matonos-flatpak-revokefs-prebuilt",
        "matonos-flatpak-xdg-dbus-proxy-prebuilt",
    ],
    native_shared_libs: [
        "libseccomp_matonos",
        "matonos-flatpak-libappstream-prebuilt",
        "matonos-flatpak-libarchive-prebuilt",
        "matonos-flatpak-libassuan-prebuilt",
        "matonos-flatpak-libffi-prebuilt",
        "matonos-flatpak-libfuse-prebuilt",
        "matonos-flatpak-libfyaml-prebuilt",
        "matonos-flatpak-libgcrypt-prebuilt",
        "matonos-flatpak-libgio-prebuilt",
        "matonos-flatpak-libgirepository-prebuilt",
        "matonos-flatpak-libglib-prebuilt",
        "matonos-flatpak-libgmodule-prebuilt",
        "matonos-flatpak-libgobject-prebuilt",
        "matonos-flatpak-libgpg-error-prebuilt",
        "matonos-flatpak-libgpgme-prebuilt",
        "matonos-flatpak-libgthread-prebuilt",
        "matonos-flatpak-libintl-prebuilt",
        "matonos-flatpak-libjson-glib-prebuilt",
        "matonos-flatpak-libksba-prebuilt",
        "matonos-flatpak-libnpth-prebuilt",
        "matonos-flatpak-libostree-prebuilt",
        "matonos-flatpak-libxmlb-prebuilt",
        "matonos-flatpak-libyaml-prebuilt",
    ],
    prebuilts: [
        "matonos-flatpak-trigger-desktop-database",
        "matonos-flatpak-trigger-gtk-icon-cache",
        "matonos-flatpak-trigger-mime-database",
    ],
}
