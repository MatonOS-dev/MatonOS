+/* Android has no writable /tmp and our compositor runs inside an app
+ * process, so the X11 socket directory is overridable through the
+ * environment. The default stays the traditional /tmp/.X11-unix; with an
+ * override the lock file lives inside the directory (the traditional
+ * location is the parent directory, /tmp/.X%d-lock).
+ *
+ * WLR_XWAYLAND_NO_ABSTRACT=1 skips the abstract-namespace bind. Abstract
+ * sockets have no filesystem permissions, so skipping it lets a per-display
+ * server rely on the ownership of the filesystem socket alone. */
+#define SOCKET_DIR_DEFAULT "/tmp/.X11-unix"
+
+static const char *socket_dir(void) {
+	const char *dir = getenv("WLR_XWAYLAND_SOCKET_DIR");
+	if (dir != NULL && dir[0] != '\0') {
+		return dir;
+	}
+	return SOCKET_DIR_DEFAULT;
+}
+
+static bool abstract_sockets_disabled(void) {
+	const char *flag = getenv("WLR_XWAYLAND_NO_ABSTRACT");
+	return flag != NULL && flag[0] != '\0' && strcmp(flag, "0") != 0;
+}
 
