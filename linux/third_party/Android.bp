package {
    default_applicable_licenses: ["matonos_linux_third_party_license"],
}

license {
    name: "matonos_linux_third_party_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-GPL-2.0-or-later",
        "SPDX-license-identifier-LGPL-2.1-or-later",
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "bubblewrap/upstream/COPYING",
        "libseccomp/upstream/LICENSE",
    ],
}

cc_library_shared {
    name: "libseccomp_matonos",
    srcs: [
        "libseccomp/upstream/src/api.c",
        "libseccomp/upstream/src/arch.c",
        "libseccomp/upstream/src/arch-aarch64.c",
        "libseccomp/upstream/src/arch-arm.c",
        "libseccomp/upstream/src/arch-mips.c",
        "libseccomp/upstream/src/arch-mips64.c",
        "libseccomp/upstream/src/arch-mips64n32.c",
        "libseccomp/upstream/src/arch-parisc.c",
        "libseccomp/upstream/src/arch-parisc64.c",
        "libseccomp/upstream/src/arch-ppc.c",
        "libseccomp/upstream/src/arch-ppc64.c",
        "libseccomp/upstream/src/arch-riscv64.c",
        "libseccomp/upstream/src/arch-s390.c",
        "libseccomp/upstream/src/arch-s390x.c",
        "libseccomp/upstream/src/arch-x32.c",
        "libseccomp/upstream/src/arch-x86.c",
        "libseccomp/upstream/src/arch-x86_64.c",
        "libseccomp/upstream/src/db.c",
        "libseccomp/upstream/src/gen_bpf.c",
        "libseccomp/upstream/src/gen_pfc.c",
        "libseccomp/upstream/src/hash.c",
        "libseccomp/upstream/src/helper.c",
        "libseccomp/upstream/src/syscalls.c",
        "libseccomp/upstream/src/syscalls.perf.c",
        "libseccomp/upstream/src/system.c",
    ],
    local_include_dirs: [
        "libseccomp/upstream/include",
        "libseccomp/upstream/src",
        "libseccomp/config",
    ],
    export_include_dirs: ["libseccomp/upstream/include"],
    cflags: [
        "-D_GNU_SOURCE",
        "-DHAVE_LINUX_SECCOMP_H=1",
        "-fvisibility=hidden",
        "-Wno-unused-parameter",
    ],
    system_ext_specific: true,
    compile_multilib: "64",
}

cc_binary {
    name: "bwrap",
    srcs: [
        "bubblewrap/upstream/bind-mount.c",
        "bubblewrap/upstream/bubblewrap.c",
        "bubblewrap/upstream/network.c",
        "bubblewrap/upstream/utils.c",
    ],
    local_include_dirs: [
        "bubblewrap",
        "bubblewrap/upstream",
    ],
    cflags: [
        "-D_GNU_SOURCE",
        "-Wno-unused-parameter",
        "-Wno-unused-result",
    ],
    shared_libs: ["libcap"],
    system_ext_specific: true,
    compile_multilib: "64",
}
