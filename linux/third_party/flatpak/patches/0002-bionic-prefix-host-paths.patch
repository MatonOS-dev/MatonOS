From: MatonOS flatpak-spike
Subject: [PATCH 0002] Make Flatpak consumer-only on bionic

On bionic, Flatpak is a consumer runtime managed by the MatonOS store app.
Omit icon validation/export and the build-only CLI commands (build-init,
build, build-finish, build-export, build-bundle, build-import-bundle,
build-sign, build-update-repo, build-commit-from). The Android store decodes
and mints icon stubs with BitmapFactory. This also removes gdk-pixbuf from the
bionic build. Keep install --bundle and normal install/run/remote/update and
management commands. Skip host OS libc exports and glibc ld.so.cache work;
Android bionic has neither host glibc paths nor ldconfig cache. Host-path and
command changes are gated to linux-android; other Linux builds retain upstream
behavior.

--- a/configure.ac
+++ b/configure.ac
@@ -360,13 +360,22 @@
       [Define if sandboxed triggers are disabled])
 fi
 
+dnl Android's bionic package is a consumer-only Flatpak build. It omits
+dnl build/export tooling and icon validation (the Android store owns icons).
+AM_CONDITIONAL([HAVE_BIONIC], [test "x$host_os" = "xlinux-android"])
+
 PKG_CHECK_MODULES(OSTREE, [ostree-1 >= $OSTREE_REQS])
 
 PKG_CHECK_MODULES(JSON, [json-glib-1.0])
 
 PKG_CHECK_MODULES(APPSTREAM, [appstream >= 0.12.0])
 
-PKG_CHECK_MODULES(GDK_PIXBUF, [gdk-pixbuf-2.0])
+if test "x$host_os" != "xlinux-android"; then
+  PKG_CHECK_MODULES(GDK_PIXBUF, [gdk-pixbuf-2.0])
+else
+  GDK_PIXBUF_CFLAGS=
+  GDK_PIXBUF_LIBS=
+fi
 
 AC_ARG_ENABLE([seccomp],
               AC_HELP_STRING([--disable-seccomp],
--- a/configure
+++ b/configure
@@ -20533,6 +20533,10 @@
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for gdk-pixbuf-2.0" >&5
 printf %s "checking for gdk-pixbuf-2.0... " >&6; }
 
+if test "x$host_os" = "xlinux-android"; then
+  GDK_PIXBUF_CFLAGS=
+  GDK_PIXBUF_LIBS=
+else
 if test -n "$GDK_PIXBUF_CFLAGS"; then
     pkg_cv_GDK_PIXBUF_CFLAGS="$GDK_PIXBUF_CFLAGS"
  elif test -n "$PKG_CONFIG"; then
@@ -20617,6 +20621,8 @@
         GDK_PIXBUF_LIBS=$pkg_cv_GDK_PIXBUF_LIBS
         { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: yes" >&5
 printf "%s\n" "yes" >&6; }
+
+fi
 
 fi
 
