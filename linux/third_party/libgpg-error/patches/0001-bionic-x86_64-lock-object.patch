From: MatonOS flatpak-spike
Subject: [PATCH] libgpg-error: add x86_64 Android lock ABI

Bionic x86_64 pthread_mutex_t is 40 bytes. Supply libgpg-error's generated
lock-object description for the NDK canonical Android host triplet so
cross-builds can generate gpg-error.h.

--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -41,6 +41,7 @@
 	syscfg/lock-obj-pub.aarch64-apple-darwin.h          \
         syscfg/lock-obj-pub.alpha-unknown-linux-gnu.h       \
         syscfg/lock-obj-pub.arm-unknown-linux-androideabi.h \
+        syscfg/lock-obj-pub.x86_64-unknown-linux-android.h \
         syscfg/lock-obj-pub.arm-unknown-linux-gnueabi.h     \
 	syscfg/lock-obj-pub.arm-apple-darwin.h              \
         syscfg/lock-obj-pub.hppa-unknown-linux-gnu.h        \
--- a/src/Makefile.in
+++ b/src/Makefile.in
@@ -534,6 +534,7 @@
 	syscfg/lock-obj-pub.aarch64-apple-darwin.h          \
         syscfg/lock-obj-pub.alpha-unknown-linux-gnu.h       \
         syscfg/lock-obj-pub.arm-unknown-linux-androideabi.h \
+        syscfg/lock-obj-pub.x86_64-unknown-linux-android.h \
         syscfg/lock-obj-pub.arm-unknown-linux-gnueabi.h     \
 	syscfg/lock-obj-pub.arm-apple-darwin.h              \
         syscfg/lock-obj-pub.hppa-unknown-linux-gnu.h        \
--- /dev/null
+++ b/src/syscfg/lock-obj-pub.x86_64-unknown-linux-android.h
@@ -0,0 +1,15 @@
+## lock-obj-pub.x86_64-unknown-linux-android.h
+## File created by gen-posix-lock-obj - DO NOT EDIT
+## To be included by mkheader into gpg-error.h
+
+typedef struct
+{
+  long _vers;
+  union {
+    volatile char _priv[40];
+    long _x_align;
+    long *_xp_align;
+  } u;
+} gpgrt_lock_t;
+
+#define GPGRT_LOCK_INITIALIZER {1,{{0}}}
