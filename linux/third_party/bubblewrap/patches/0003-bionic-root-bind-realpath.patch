# Bionic realpath() reports ENOENT on the new-root path after a successful bind
# of the old root during bubblewrap's pivot-root sequence. Keep the internal
# canonical path and let the following open() validate it.
--- a/bind-mount.c
+++ b/bind-mount.c
@@ -403,7 +403,14 @@
      path, so to find it in the mount table we need to do that too. */
   resolved_dest = realpath (dest, NULL);
   if (resolved_dest == NULL)
-    return BIND_MOUNT_ERROR_REALPATH_DEST;
+    {
+      /* Bionic realpath() can report ENOENT for bubblewrap's pivot-root
+       * destination after the root bind mount has succeeded. The destination
+       * is a canonical internal path and the following open() verifies it. */
+      if (errno != ENOENT || strcmp (dest, "/newroot/") != 0)
+        return BIND_MOUNT_ERROR_REALPATH_DEST;
+      resolved_dest = xstrdup (dest);
+    }
 
   dest_fd = open (resolved_dest, O_PATH | O_CLOEXEC);
   if (dest_fd < 0)
