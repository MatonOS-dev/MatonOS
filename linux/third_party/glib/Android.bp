package {
    default_applicable_licenses: ["matonos_linux_third_party_license"],
}

// GLib core only; GObject, GModule and GIO are added as separate spike steps.
cc_library_shared {
    name: "libglib-2.0_matonos",
    srcs: [
        "upstream/glib/deprecated/gallocator.c",
        "upstream/glib/deprecated/gcache.c",
        "upstream/glib/deprecated/gcompletion.c",
        "upstream/glib/deprecated/grel.c",
        "upstream/glib/deprecated/gthread-deprecated.c",
        "upstream/glib/garcbox.c",
        "upstream/glib/garray.c",
        "upstream/glib/gasyncqueue.c",
        "upstream/glib/gatomic.c",
        "upstream/glib/gbacktrace.c",
        "upstream/glib/gbase64.c",
        "upstream/glib/gbitlock.c",
        "upstream/glib/gbookmarkfile.c",
        "upstream/glib/gbytes.c",
        "upstream/glib/gcharset.c",
        "upstream/glib/gchecksum.c",
        "upstream/glib/gconvert.c",
        "upstream/glib/gdataset.c",
        "upstream/glib/gdate.c",
        "upstream/glib/gdatetime-private.c",
        "upstream/glib/gdatetime.c",
        "upstream/glib/gdir.c",
        "upstream/glib/genviron.c",
        "upstream/glib/gerror.c",
        "upstream/glib/gfileutils.c",
        "upstream/glib/ggettext.c",
        "upstream/glib/ghash.c",
        "upstream/glib/ghmac.c",
        "upstream/glib/ghook.c",
        "upstream/glib/ghostutils.c",
        "upstream/glib/giochannel.c",
        "upstream/glib/giounix.c",
        "upstream/glib/gjournal-private.c",
        "upstream/glib/gkeyfile.c",
        "upstream/glib/glib-init.c",
        "upstream/glib/glib-private.c",
        "upstream/glib/glib-unix.c",
        "upstream/glib/glist.c",
        "upstream/glib/libcharset/localcharset.c",
        "upstream/glib/gmain.c",
        "upstream/glib/gmappedfile.c",
        "upstream/glib/gmarkup.c",
        "upstream/glib/gmem.c",
        "upstream/glib/gmessages.c",
        "upstream/glib/gnode.c",
        "upstream/glib/goption.c",
        "upstream/glib/gpathbuf.c",
        "upstream/glib/gpattern.c",
        "upstream/glib/gpoll.c",
        "upstream/glib/gprimes.c",
        "upstream/glib/gprintf.c",
        "upstream/glib/gqsort.c",
        "upstream/glib/gquark.c",
        "upstream/glib/gqueue.c",
        "upstream/glib/grand.c",
        "upstream/glib/grcbox.c",
        "upstream/glib/grefcount.c",
        "upstream/glib/grefstring.c",
        "upstream/glib/gregex.c",
        "upstream/glib/gscanner.c",
        "upstream/glib/gsequence.c",
        "upstream/glib/gshell.c",
        "upstream/glib/gslice.c",
        "upstream/glib/gslist.c",
        "upstream/glib/gspawn.c",
        "upstream/glib/gstdio.c",
        "upstream/glib/gstrfuncs.c",
        "upstream/glib/gstring.c",
        "upstream/glib/gstringchunk.c",
        "upstream/glib/gstrvbuilder.c",
        "upstream/glib/gtestutils.c",
        "upstream/glib/gthread-posix.c",
        "upstream/glib/gthread.c",
        "upstream/glib/gthreadpool.c",
        "upstream/glib/gtimer.c",
        "upstream/glib/gtimezone.c",
        "upstream/glib/gtrace.c",
        "upstream/glib/gtranslit.c",
        "upstream/glib/gtrashstack.c",
        "upstream/glib/gtree.c",
        "upstream/glib/gunibreak.c",
        "upstream/glib/gunicollate.c",
        "upstream/glib/gunidecomp.c",
        "upstream/glib/guniprop.c",
        "upstream/glib/guri.c",
        "upstream/glib/gutf8.c",
        "upstream/glib/gutils.c",
        "upstream/glib/guuid.c",
        "upstream/glib/gvariant-core.c",
        "upstream/glib/gvariant-parser.c",
        "upstream/glib/gvariant-serialiser.c",
        "upstream/glib/gvariant.c",
        "upstream/glib/gvarianttype.c",
        "upstream/glib/gvarianttypeinfo.c",
        "upstream/glib/gversion.c",
        "upstream/glib/gwakeup.c",
    ],
    local_include_dirs: [
        "upstream",
        "upstream/glib",
        "config",
    ],
    export_include_dirs: [
        "upstream",
        "config",
    ],
    cflags: [
        "-D_GNU_SOURCE",
        "-DHAVE_CONFIG_H",
        "-DGLIB_COMPILATION",
        "-include config.h",
        "-std=gnu17",
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    shared_libs: [
        "libpcre2",
        "libm",
    ],
    system_ext_specific: true,
    compile_multilib: "64",
}

// GLib dynamic module loader, backed by Bionic's dlopen API.
cc_library_shared {
    name: "libgmodule-2.0_matonos",
    srcs: [
        "upstream/gmodule/gmodule.c",
        "upstream/gmodule/gmodule-deprecated.c",
    ],
    local_include_dirs: [
        "upstream",
        "upstream/glib",
        "upstream/gmodule",
        "config",
        "config/gmodule",
    ],
    export_include_dirs: [
        "upstream",
        "config",
        "config/gmodule",
    ],
    cflags: [
        "-D_GNU_SOURCE",
        "-DHAVE_CONFIG_H",
        "-DGMODULE_COMPILATION",
        "-DG_LOG_DOMAIN=\"GModule\"",
        "-include config.h",
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    shared_libs: [
        "libglib-2.0_matonos",
        "libdl",
    ],
    system_ext_specific: true,
    compile_multilib: "64",
}

// GLib's object system. libffi is reused from AOSP external/libffi.
cc_library_shared {
    name: "libgobject-2.0_matonos",
    srcs: [
        "config/gobject/glib-enumtypes.c",
        "upstream/gobject/gatomicarray.c",
        "upstream/gobject/gbinding.c",
        "upstream/gobject/gbindinggroup.c",
        "upstream/gobject/gboxed.c",
        "upstream/gobject/gclosure.c",
        "upstream/gobject/genums.c",
        "upstream/gobject/gmarshal.c",
        "upstream/gobject/gobject.c",
        "upstream/gobject/gparam.c",
        "upstream/gobject/gparamspecs.c",
        "upstream/gobject/gsignal.c",
        "upstream/gobject/gsignalgroup.c",
        "upstream/gobject/gsourceclosure.c",
        "upstream/gobject/gtype.c",
        "upstream/gobject/gtypemodule.c",
        "upstream/gobject/gtypeplugin.c",
        "upstream/gobject/gvalue.c",
        "upstream/gobject/gvaluearray.c",
        "upstream/gobject/gvaluetransform.c",
        "upstream/gobject/gvaluetypes.c",
    ],
    local_include_dirs: [
        "upstream",
        "upstream/glib",
        "upstream/gobject",
        "config",
        "config/gobject",
    ],
    export_include_dirs: [
        "upstream",
        "config",
        "config/gobject",
    ],
    cflags: [
        "-D_GNU_SOURCE",
        "-DHAVE_CONFIG_H",
        "-DGOBJECT_COMPILATION",
        "-DG_LOG_DOMAIN=\"GLib-GObject\"",
        "-include config.h",
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    shared_libs: [
        "libglib-2.0_matonos",
        "libffi",
    ],
    system_ext_specific: true,
    compile_multilib: "64",
}
