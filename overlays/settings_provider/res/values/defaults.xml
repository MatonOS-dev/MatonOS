<resources>
    <!-- Android never turns the screen off: MatonOS's sleep daemon
         (power/matonos-sleepd.c) decides when the PC sleeps. -->
    <integer name="def_screen_off_timeout">2147483647</integer>
    <!-- Bluetooth starts off: on a PC without a controller the stock HAL fails
         init and the Bluetooth stack aborts on it, so enabling at boot would
         crash-loop com.android.bluetooth. The user's own toggle persists. -->
    <bool name="def_bluetooth_on">false</bool>
</resources>
