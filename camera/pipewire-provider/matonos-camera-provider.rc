# No dependency on camera devices, discovery, or PipeWire connectivity.
# Runs as audio: PipeWire sockets are 0700 audio, and the runtime dir is audio-owned.
service vendor.camera.provider-ext /apex/com.matonos.hardware.media/bin/hw/matonos-camera-provider
    interface aidl android.hardware.camera.provider.ICameraProvider/external/0
    class hal
    user audio
    group camera input drmrpc usb
    setenv HOME /data/vendor/maton-audio
    setenv XDG_RUNTIME_DIR /data/vendor/maton-audio
    setenv PIPEWIRE_RUNTIME_DIR /data/vendor/maton-audio
    setenv PIPEWIRE_CONFIG_DIR /apex/com.matonos.hardware.media/etc/pipewire
    setenv PIPEWIRE_MODULE_DIR /apex/com.matonos.hardware.media/lib64/pipewire-0.3
    setenv SPA_PLUGIN_DIR /apex/com.matonos.hardware.media/lib64/spa-0.2
    setenv PIPEWIRE_VM 0
    setenv LD_LIBRARY_PATH /apex/com.matonos.hardware.media/lib64
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance
