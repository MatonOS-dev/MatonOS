# The service handles OTA in installed sessions and full installation in a live
# session. Its asynchronous startup never gates boot; destructive install
# operations still check the live-image kernel command line.
service matonos-installer-service /odm/bin/matonos-installer-service
    class late_start
    user root
    group root
    disabled
    restart_period 10

# The system image remains usable without installer support or target disks.
on post-fs-data
    start matonos-installer-service
