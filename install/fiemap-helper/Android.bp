cc_binary {
    name: "matonos-fiemap-helper",
    srcs: [
        "matonos_fiemap_helper.cpp",
        "//system/fs/fs_mgr/libfiemap:libfiemap_srcs",
    ],
    system_ext_specific: true,
    init_rc: ["matonos-fiemap-helper.rc"],
    cpp_std: "c++20",
    static_libs: [
        "libavb",
        "libdm",
        "libext2_uuid",
        "libfs_avb",
        "libfscrypt",
        "libfstab",
        "libgsi",
        "liblogwrap",
    ],
    shared_libs: [
        "libbase",
        "libcrypto",
        "libcrypto_utils",
        "libcutils",
        "libext4_utils",
        "libfs_mgr",
        "liblog",
        "liblp",
        "libselinux",
    ],
}
