# Flatpak management starts after Android has booted; service absence never blocks boot.
service matonos-linuxd /system_ext/bin/matonos-linuxd
    class late_start
    user system
    group system inet
    # SETUID/SETGID are inherited by the staging helper for fixed FPINSTALL pulls.
    # linuxd needs CHOWN/FOWNER to seal downloaded staging objects.
    capabilities SETGID SETUID CHOWN FOWNER
    disabled
    restart_period 5
    seclabel u:r:matonos_linuxd:s0

# Same system DE encryption policy as PackageManager's /data/app sibling.
on post-fs-data
    mkdir /data/linux-app 0755 system system encryption=Require
    restorecon /data/linux-app

on property:sys.boot_completed=1
    start matonos-linuxd
