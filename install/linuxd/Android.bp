filegroup {
    name: "matonos-linuxd-aidl",
    srcs: [
        "aidl/org/matonos/systembridge/ILinuxd.aidl",
        "aidl/org/matonos/systembridge/ILinuxdListener.aidl",
    ],
    path: "aidl",
}

cc_binary {
    name: "matonos-linuxd",
    srcs: [
        "MatonosLinuxd.cpp",
        "FlatpakManager.c",
        "UdevDatabase.c",
        ":matonos-linuxd-aidl",
    ],
    shared_libs: [
        "libbinder",
        "libjsoncpp",
        "liblog",
        "libutils",
    ],
    aidl: {
        local_include_dirs: ["aidl"],
    },
    init_rc: ["MatonosLinuxd.rc"],
    system_ext_specific: true,
    compile_multilib: "64",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

// r24 installer helper: the only domain allowed to create, grow, loop-mount
// and fs-verity the Flatpak code store images. linuxd execs it; the SELinux
// transition and file_contexts label are in systembridge/sepolicy.
cc_binary {
    name: "matonos-flatpak-store",
    srcs: [
        "FlatpakStore.c",
    ],
    init_rc: [],
    system_ext_specific: true,
    compile_multilib: "64",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
