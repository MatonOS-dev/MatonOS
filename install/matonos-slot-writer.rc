service matonos-slot-writer /system_ext/bin/matonos-slot-writer --request /maton_system/ota-staging/.request /maton_system/ota-staging/.result
    class late_start
    user root
    group root
    disabled
    oneshot
    stdio_to_kmsg

# The vendor installer only submits a bounded request and waits for this init
# started system_ext service. It never executes a system_ext binary itself.
on property:vendor.maton.install.slot_writer.request=*
    restorecon_recursive /metadata/maton
    exec_start matonos-slot-writer
    setprop vendor.maton.install.slot_writer.done ${vendor.maton.install.slot_writer.request}
