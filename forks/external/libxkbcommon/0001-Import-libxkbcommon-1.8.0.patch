+    // Only care about Shift; Lock will be filter out
+    modifiers = Shift;
+    // Define mapping
+    map[None]  = Level1; // No modifier   -> level 1
+    map[Shift] = Level2; // Exactly Shift -> level 2
+    // (no map entry with Lock)
+    // Define level names
+    level_name[Level1] = "Base";
+    level_name[Level2] = "Shift";
+};
