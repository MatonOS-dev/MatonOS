+        {%- endif %}{%- if entry[ref].levels|length > 2 %} NEXT,
+        KEY_RIGHTALT, DOWN, XKB_KEY_ISO_Level3_Shift, NEXT,
+        {{ key_seq(entry, ref, 2) }}, NEXT,
+        KEY_RIGHTALT, UP, XKB_KEY_ISO_Level3_Shift,
+        {%- endif %}{% if not loop.last %} NEXT,{% endif %}
+        {% else %}
