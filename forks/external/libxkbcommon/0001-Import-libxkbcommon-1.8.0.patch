+        KEY_Z,         DOWN, XKB_KEY_Control_L, XKB_KEY_ISO_Group_Shift, NEXT,
+        KEY_2,         BOTH, XKB_KEY_ecaron,   NEXT,
+        KEY_Z,         UP,   XKB_KEY_y,        NEXT,
+        KEY_X,         BOTH, XKB_KEY_x,        NEXT,
