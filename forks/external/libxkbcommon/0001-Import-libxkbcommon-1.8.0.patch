+bool
+is_pipe_or_regular_file(int fd)
+{
+    struct stat info;
+    if (fstat(fd, &info) == 0) {
+        return S_ISFIFO(info.st_mode) || S_ISREG(info.st_mode);
+    } else {
+        return false;
