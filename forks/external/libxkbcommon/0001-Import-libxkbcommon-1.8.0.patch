+    def write(self, root: Path) -> None:
+        path = root / "src/keysym-case-mappings.c"
+        keysyms = self.generate_mapping("legacy_keysym_", self.legacy_keysyms)
+        unicode = self.generate_mapping("unicode_", self.unicode)
