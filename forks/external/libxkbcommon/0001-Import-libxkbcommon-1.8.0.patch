+        KEY_LVL5,      DOWN, XKB_KEY_ISO_Level3_Shift, XKB_KEY_ISO_Group_Shift, NEXT,
+        KEY_2,         BOTH, XKB_KEY_at,        NEXT,
+        KEY_LVL5,      UP,   XKB_KEY_ISO_Level3_Shift, XKB_KEY_ISO_Group_Shift, NEXT,
+        KEY_2,         BOTH, XKB_KEY_2,         NEXT,
