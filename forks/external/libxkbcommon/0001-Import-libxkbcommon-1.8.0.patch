+        KEY_2,         BOTH, XKB_KEY_2,        NEXT,
+        KEY_RO,        UP,   XKB_KEY_Control_L, XKB_KEY_Shift_L, NEXT,
+        KEY_YEN,       DOWN, XKB_KEY_Control_L, XKB_KEY_Shift_L, NEXT,
+        KEY_2,         BOTH, XKB_KEY_2,        NEXT,
+        KEY_YEN,       UP,   XKB_KEY_Control_L, XKB_KEY_Shift_L, NEXT,
