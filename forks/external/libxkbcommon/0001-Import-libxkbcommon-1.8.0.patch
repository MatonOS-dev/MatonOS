+
+/* Case mappings for Unicode {unicode_version}
+ *
+{doc}
+ */
+
+#include "config.h"
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include "xkbcommon/xkbcommon.h"
+#include "utils.h"
