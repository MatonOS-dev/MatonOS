+    }                                                                          \
+                                                                               \
+    static void rvv_combine_##name##_ca (                                      \
+	pixman_implementation_t *imp, pixman_op_t op, uint32_t *dest,          \
+	const uint32_t *src, const uint32_t *mask, int width)                  \
+    {                                                                          \
