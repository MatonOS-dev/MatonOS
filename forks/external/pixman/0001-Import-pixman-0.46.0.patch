+			   rvv_UN8x4_ADD_UN8x4_vv_m4 (
+			       rvv_UN8x4_MUL_UN8x4_vv_m4 (d, s, vl),
+			       rvv_UN8x4_MUL_UN16_ADD_UN8x4_MUL_UN16_vvvv_m4 (
