+static void update_pixels_10bpp(unsigned char *mem, uint64_t val, uint64_t mask)
+{
+	int i;
+
+	for (i = 0; i < 5; i++, mask >>= 8, val >>= 8) {
+		mem[i] &= ~(mask & 0xff);
+		mem[i] |= (mask & 0xff) & val;
+	}
+}
