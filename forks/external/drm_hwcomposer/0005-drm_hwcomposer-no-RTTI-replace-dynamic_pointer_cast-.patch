From 0e6fe0670630fba69ebbd07ae3c819c294c824fb Mon Sep 17 00:00:00 2001
From: Hanro <hlareman2@gmail.com>
Date: Sun, 27 Sep 2026 15:06:41 +0200
Subject: [PATCH 5/6] drm_hwcomposer: no RTTI - replace dynamic_pointer_cast
 with IsDumbBuffer() check

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: If5107c3533ea1e5a460b1314312a09425763302f
---
 bufferinfo/BufferInfo.h | 2 ++
 drm/DrmDevice.cpp       | 6 +++++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/bufferinfo/BufferInfo.h b/bufferinfo/BufferInfo.h
index 29c40a3..db45828 100644
--- a/bufferinfo/BufferInfo.h
+++ b/bufferinfo/BufferInfo.h
@@ -46,6 +46,8 @@ enum class BufferBlendMode : int32_t {
 class PrimeFdsSharedBase {
  public:
   virtual ~PrimeFdsSharedBase() = default;
+  // AOSP builds without RTTI: a type check instead of dynamic_pointer_cast.
+  virtual bool IsDumbBuffer() const { return false; }
 };
 
 struct BufferInfo {
diff --git a/drm/DrmDevice.cpp b/drm/DrmDevice.cpp
index 064baaf..0530970 100644
--- a/drm/DrmDevice.cpp
+++ b/drm/DrmDevice.cpp
@@ -406,6 +406,8 @@ class DumbBufferFd : public PrimeFdsSharedBase {
     }
   }
 
+  bool IsDumbBuffer() const override { return true; }
+
   SharedFd fd;
   void *mapping = MAP_FAILED;
   size_t mapping_size = 0;
@@ -543,7 +545,9 @@ auto DrmDevice::CopyBufferToDumb(const BufferInfo &source)
     return {};
   }
 
-  auto dumb_buffer = std::dynamic_pointer_cast<DumbBufferFd>(target->fds_shared);
+  auto dumb_buffer = target->fds_shared && target->fds_shared->IsDumbBuffer()
+                         ? std::static_pointer_cast<DumbBufferFd>(target->fds_shared)
+                         : nullptr;
   if (!dumb_buffer || dumb_buffer->mapping == MAP_FAILED ||
       dumb_buffer->mapping_size < target_size) {
     ALOGE("KMS dumb buffer has no valid MODE_MAP_DUMB mapping");
-- 
2.43.0

