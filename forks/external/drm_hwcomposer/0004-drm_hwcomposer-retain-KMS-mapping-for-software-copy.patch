From c0cefb99589b7d75656134360952c5d8ce6f6ce8 Mon Sep 17 00:00:00 2001
From: Hanro <hlareman2@gmail.com>
Date: Sun, 27 Sep 2026 12:44:34 +0200
Subject: [PATCH 4/5] drm_hwcomposer: retain KMS mapping for software copy

Change-Id: Ifca9b0269a7b4eefe1cfc28d369f85c086aec72d
---
 drm/DrmDevice.cpp | 35 +++++++++++++++++++++--------------
 1 file changed, 21 insertions(+), 14 deletions(-)

diff --git a/drm/DrmDevice.cpp b/drm/DrmDevice.cpp
index 4ead116..064baaf 100644
--- a/drm/DrmDevice.cpp
+++ b/drm/DrmDevice.cpp
@@ -400,7 +400,15 @@ auto DrmDevice::GetEncoders()
 
 class DumbBufferFd : public PrimeFdsSharedBase {
  public:
+  ~DumbBufferFd() override {
+    if (mapping != MAP_FAILED) {
+      munmap(mapping, mapping_size);
+    }
+  }
+
   SharedFd fd;
+  void *mapping = MAP_FAILED;
+  size_t mapping_size = 0;
 };
 
 // NOLINTBEGIN(cppcoreguidelines-avoid-goto)
@@ -461,9 +469,11 @@ auto DrmDevice::CreateBufferForModeset(uint32_t width, uint32_t height)
 
   memset(ptr, 0, create.size);
 
-  if (munmap(ptr, create.size) != 0) {
-    ALOGE("Failed to unmap dumb buffer: %d", errno);
-  }
+  // Keep the KMS-fd mapping alive with the shared dumb BO. Some VRAM-backed
+  // drivers cannot mmap the exported dma-buf, even though MODE_MAP_DUMB works.
+  dumb_buffer_fd->mapping = ptr;
+  dumb_buffer_fd->mapping_size = create.size;
+  ptr = MAP_FAILED;
 
   ret = drmPrimeHandleToFD(*fd_, create.handle, 0, &buffer_info.prime_fds[0]);
   if (ret != 0) {
@@ -532,24 +542,22 @@ auto DrmDevice::CopyBufferToDumb(const BufferInfo &source)
     }
     return {};
   }
-  const bool target_sync =
-      DmaBufSync(target->prime_fds[0], DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE);
-  void *target_map = mmap(nullptr, target_size, PROT_READ | PROT_WRITE,
-                          MAP_SHARED, target->prime_fds[0], 0);
-  if (target_map == MAP_FAILED) {
-    ALOGE("Unable to map KMS dumb buffer for software display copy");
-    if (target_sync) {
-      DmaBufSync(target->prime_fds[0], DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE);
-    }
+
+  auto dumb_buffer = std::dynamic_pointer_cast<DumbBufferFd>(target->fds_shared);
+  if (!dumb_buffer || dumb_buffer->mapping == MAP_FAILED ||
+      dumb_buffer->mapping_size < target_size) {
+    ALOGE("KMS dumb buffer has no valid MODE_MAP_DUMB mapping");
     munmap(source_map, source_size);
     if (source_sync) {
       DmaBufSync(source.prime_fds[0], DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
     }
     return {};
   }
+  const bool target_sync =
+      DmaBufSync(target->prime_fds[0], DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE);
 
   const auto *src = static_cast<const uint8_t *>(source_map);
-  auto *dst = static_cast<uint8_t *>(target_map);
+  auto *dst = static_cast<uint8_t *>(dumb_buffer->mapping);
   const size_t row_bytes = static_cast<size_t>(source.width) * 4;
   for (uint32_t y = 0; y < source.height; ++y) {
     const uint8_t *src_row = src + static_cast<size_t>(y) * source.pitches[0];
@@ -568,7 +576,6 @@ auto DrmDevice::CopyBufferToDumb(const BufferInfo &source)
   if (source_sync) {
     DmaBufSync(source.prime_fds[0], DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
   }
-  munmap(target_map, target_size);
   munmap(source_map, source_size);
   return target;
 }
-- 
