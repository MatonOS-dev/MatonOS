From a0ddb5b57bfe1b6308540179c9aa7d6412210021 Mon Sep 17 00:00:00 2001
From: Hanro <hlareman2@gmail.com>
Date: Sun, 27 Sep 2026 07:39:46 +0200
Subject: [PATCH 2/2] drm_hwcomposer: copy unsupported client targets to dumb
 buffers

Change-Id: I77579c5589abcb4dccd3101c867f8aef91e82dab
---
 drm/DrmDevice.cpp       | 70 +++++++++++++++++++++++++++++++++++++++++
 drm/DrmDevice.h         |  4 +++
 hwc3/ComposerClient.cpp | 21 +++++++++++++
 3 files changed, 95 insertions(+)

diff --git a/drm/DrmDevice.cpp b/drm/DrmDevice.cpp
index 7816e02..d92c5a3 100644
--- a/drm/DrmDevice.cpp
+++ b/drm/DrmDevice.cpp
@@ -21,8 +21,10 @@
 #include <xf86drm.h>
 #include <xf86drmMode.h>
 
+#include <algorithm>
 #include <cinttypes>
 #include <cstdint>
+#include <cstring>
 #include <string>
 
 #include "bufferinfo/BufferInfo.h"
@@ -473,6 +475,74 @@ done:
 
   return result;
 }
+
+auto DrmDevice::CopyBufferToDumb(const BufferInfo &source)
+    -> std::optional<BufferInfo> {
+  if (source.width == 0 || source.height == 0 || source.prime_fds[0] < 0 ||
+      (source.modifiers[0] != DRM_FORMAT_MOD_NONE &&
+       source.modifiers[0] != DRM_FORMAT_MOD_INVALID) ||
+      source.pitches[0] < source.width * 4) {
+    return {};
+  }
+
+  // Bochs and similar VRAM-helper KMS drivers accept XRGB8888 dumb buffers,
+  // but cannot import vgem's shmem dma-bufs. Limit the slow copy path to the
+  // common 32-bit client-target formats so ordinary layer imports stay fast.
+  bool swap_red_blue = false;
+  switch (source.format) {
+    case DRM_FORMAT_XRGB8888:
+    case DRM_FORMAT_ARGB8888:
+      break;
+    case DRM_FORMAT_XBGR8888:
+    case DRM_FORMAT_ABGR8888:
+      swap_red_blue = true;
+      break;
+    default:
+      return {};
+  }
+
+  auto target = CreateBufferForModeset(source.width, source.height);
+  if (!target || target->prime_fds[0] < 0 ||
+      target->pitches[0] < source.width * 4) {
+    return {};
+  }
+
+  const size_t source_size = static_cast<size_t>(source.pitches[0]) *
+                             source.height;
+  const size_t target_size = static_cast<size_t>(target->pitches[0]) *
+                             target->height;
+  void *source_map = mmap(nullptr, source_size, PROT_READ, MAP_SHARED,
+                          source.prime_fds[0], 0);
+  if (source_map == MAP_FAILED) {
+    ALOGE("Unable to map client-target dma-buf for software display copy");
+    return {};
+  }
+  void *target_map = mmap(nullptr, target_size, PROT_READ | PROT_WRITE,
+                          MAP_SHARED, target->prime_fds[0], 0);
+  if (target_map == MAP_FAILED) {
+    ALOGE("Unable to map KMS dumb buffer for software display copy");
+    munmap(source_map, source_size);
+    return {};
+  }
+
+  const auto *src = static_cast<const uint8_t *>(source_map);
+  auto *dst = static_cast<uint8_t *>(target_map);
+  const size_t row_bytes = static_cast<size_t>(source.width) * 4;
+  for (uint32_t y = 0; y < source.height; ++y) {
+    const uint8_t *src_row = src + static_cast<size_t>(y) * source.pitches[0];
+    uint8_t *dst_row = dst + static_cast<size_t>(y) * target->pitches[0];
+    std::memcpy(dst_row, src_row, row_bytes);
+    if (swap_red_blue) {
+      for (size_t x = 0; x < row_bytes; x += 4) {
+        std::swap(dst_row[x], dst_row[x + 2]);
+      }
+    }
+  }
+
+  munmap(target_map, target_size);
+  munmap(source_map, source_size);
+  return target;
+}
 // NOLINTEND(cppcoreguidelines-avoid-goto)
 
 }  // namespace android::drm_hwcomposer
diff --git a/drm/DrmDevice.h b/drm/DrmDevice.h
index 5e60a2d..cda0b26 100644
--- a/drm/DrmDevice.h
+++ b/drm/DrmDevice.h
@@ -87,6 +87,10 @@ class DrmDevice {
   auto CreateBufferForModeset(uint32_t width, uint32_t height)
       -> std::optional<BufferInfo>;
 
+  // Copy a client target into a KMS-local dumb buffer when the display driver
+  // cannot import the allocator's dma-buf (for example bochs-drm in QEMU).
+  auto CopyBufferToDumb(const BufferInfo &source) -> std::optional<BufferInfo>;
+
   auto &GetDefaultFbImporter() {
     return *drm_fb_importer_;
   }
diff --git a/hwc3/ComposerClient.cpp b/hwc3/ComposerClient.cpp
index 0e5d7d9..a17b7cf 100644
--- a/hwc3/ComposerClient.cpp
+++ b/hwc3/ComposerClient.cpp
@@ -39,6 +39,7 @@
 #include <android/binder_auto_utils.h>
 #include <android/binder_ibinder_platform.h>
 #include <cutils/native_handle.h>
+#include <sync/sync.h>
 #include <ui/GraphicBufferMapper.h>
 #include <utils/Trace.h>
 
@@ -1710,6 +1711,26 @@ void ComposerClient::ExecuteSetDisplayClientTarget(
                                            fence),
                                        command.buffer.slot);
 
+  // The client target is the final, already-composited frame. If the display
+  // KMS driver rejects its dma-buf, copy it to a KMS-local dumb buffer. This
+  // is intentionally limited to the client target; normal hardware layer
+  // imports and scanout remain zero-copy.
+  if (buffer && !buffer->fb && buffer->bi.prime_fds[0] >= 0) {
+    const int acquire_fence = buffer->fence ? *buffer->fence : -1;
+    if (acquire_fence < 0 || sync_wait(acquire_fence, 3000) == 0) {
+      auto copied = display->GetPipe().device->CopyBufferToDumb(buffer->bi);
+      if (copied) {
+        auto fb = ImportFb(display, *copied);
+        if (fb) {
+          buffer->bi = std::move(*copied);
+          buffer->fb = std::move(fb);
+        }
+      }
+    } else {
+      ALOGE("Client-target acquire fence did not signal for software copy");
+    }
+  }
+
   if (!buffer) {
     ALOGE("Failed to import client target buffer.");
     /* Here, sending an error would be the natural way to do the thing.
-- 
