From 139968a9db60618007d2e08a15b76ebca899ad6f Mon Sep 17 00:00:00 2001
From: Hanro <hlareman2@gmail.com>
Date: Thu, 24 Sep 2026 23:19:38 +0200
Subject: [PATCH 1/6] drm_hwcomposer: scan DRM card nodes past gaps

Change-Id: I684304d8f24bca71600fd89c43944bbf0cfd8f7f
---
 drm/ResourceManager.cpp | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/drm/ResourceManager.cpp b/drm/ResourceManager.cpp
index defec12..392f47b 100644
--- a/drm/ResourceManager.cpp
+++ b/drm/ResourceManager.cpp
@@ -53,7 +53,7 @@ void ResourceManager::Init() {
   force_p3_support_ = Properties::ForceP3Support();
 
   // Could be a valid path or it can have at the end of it the wildcard %
-  // which means that it will try open all devices until an error is met.
+  // which means that it will try to open all matching devices.
   std::string path_pattern = Properties::GetDevicePath();
   if (path_pattern.empty()) {
     path_pattern = "/dev/dri/card%";
@@ -65,13 +65,17 @@ void ResourceManager::Init() {
     }
   } else {
     path_pattern.resize(path_pattern.size() - 1);
-    for (int idx = 0;; ++idx) {
+    // Card numbers can have gaps: on PCs the firmware framebuffer (simpledrm)
+    // takes card0 and goes away when the real GPU driver loads as card1+.
+    // Scan a fixed range instead of stopping at the first missing node.
+    constexpr int kMaxCards = 16;
+    for (int idx = 0; idx < kMaxCards; ++idx) {
       std::ostringstream path;
       path << path_pattern << idx;
 
       struct stat buf {};
       if (stat(path.str().c_str(), &buf) != 0)
-        break;
+        continue;
 
       auto dev = DrmDevice::CreateInstance(path.str(), this, idx);
       if (dev) {
