# Vendor ueventd config for pc_x86_64 (installed as /vendor/etc/ueventd.rc).
# /dev/dri/*, input, etc. are already covered by the platform ueventd.rc.

# PC hardware varies: load modules from /vendor/lib/modules by modalias as
# devices appear, instead of a fixed modules.load list.
modalias_handling enabled

# linux-firmware is staged into /vendor/firmware by build-kernel.sh
firmware_directories /vendor/firmware/

# addons: the manager publishes verified firmware symlinks from the active
# add-on versions here. ueventd searches each listed directory for FIRMWARE.
firmware_directories /mnt/vendor/addons/firmware/

# GID 2900 is reserved for future raw-HID grants. Uinput is linuxd-owned.
/dev/hidraw*              0660   root       vendor_game_controllers
/dev/uinput               0660   root       vendor_linuxd_uinput

/dev/rtc0                 0664   system     system

# bluetooth: the HCI HAL toggles its selected controller through rfkill.
/dev/rfkill               0660   bluetooth  bluetooth
