# Shared SELinux identity for MatonOS hardware and platform glue daemons/HALs.
# This fixed policy set trades isolation between our drivers for faster Soong
# analysis; Android and the system bridge remain outside this domain.
type matonos_driver, domain;
type matonos_driver_exec, exec_type, vendor_file_type, file_type;
type matonos_driver_helper, domain;
type matonos_driver_helper_exec, exec_type, vendor_file_type, file_type;
type matonos_driver_data_file, file_type, data_file_type;
type matonos_channel_service, protected_service, hal_service_type, service_manager_type;
type matonos_install_block_device, dev_type;
# addons: GPT entries 6/7 hold service-written raw ext4 slot images, mounted RO.
type matonos_addons_block_device, dev_type;
type vendor_addon_module_file, file_type, vendor_file_type, contextmount_type;
type matonos_addon_data_file, file_type, data_file_type;
type matonos_addon_manager, domain;
type matonos_addon_manager_exec, exec_type, vendor_file_type, file_type;
type hal_audio_default_tmpfs, file_type;
# Firmware lookup symlinks are baked into the signed ext4 image and mounted
# read-only. vendor_file_type grants ueventd its normal read/search access.
type matonos_addon_firmware_lookup, file_type, vendor_file_type;
# Read-only overlay exposing add-on + OS firmware at firmware_class.path.
type matonos_addon_firmware_overlay, file_type, vendor_file_type, contextmount_type;

init_daemon_domain(matonos_driver)
init_daemon_domain(matonos_addon_manager)
tmpfs_domain(hal_audio_default)
# vendor_init runs property actions imported from the ODM bundle. The
# properties use the existing public MatonOS vendor type; no platform-owned
# properties are writable through this grant.
set_prop(vendor_init, vendor_maton_prop)
allow vendor_init mnt_vendor_file:dir { create_dir_perms mounton };
# This release accepts modules and firmware only. It rejects package daemons,
# so no dynamic entrypoint under /mnt/vendor needs a vendor-domain transition.

# HAL servers cannot execute helpers without a domain transition. PipeWire's
# proxy starts pw-cat; the installer uses this helper domain for system tools.
# This transition must happen when a driver process executes the existing
# driver executable label.
domain_auto_trans(matonos_driver, matonos_driver_helper_exec, matonos_driver_helper)
domain_auto_trans(matonos_driver, matonos_driver_exec, matonos_driver_helper)
allow matonos_driver matonos_driver_helper:process signal;

# Narrow helper permissions: pw-cat reaches PipeWire's private socket, the
# VHCI child uses /dev/vhci, and the installer invokes fixed system format/GPT
# tools plus BLKRRPART after driver-domain validation.
allow matonos_driver_helper matonos_driver_data_file:dir search;
allow matonos_driver_helper matonos_driver_data_file:sock_file write;
allow matonos_driver_helper matonos_driver:unix_stream_socket connectto;
allow matonos_driver_helper matonos_vhci_device:chr_file rw_file_perms;
set_prop(matonos_driver_helper, vendor_maton_prop)
get_prop(matonos_driver_helper, vendor_maton_prop)
allow matonos_driver_helper vendor_file:dir r_dir_perms;
allow matonos_driver_helper vendor_file:file { getattr map open read };
allow matonos_driver matonos_install_block_device:blk_file rw_file_perms;
# The manager stages signed package and compressed image data under /data,
# then writes only the selected add-on GPT block device. The mounted filesystem is RO.
allow matonos_addon_manager matonos_addons_block_device:blk_file rw_file_perms;
allow matonos_addon_manager self:capability sys_admin;
allow matonos_addon_manager matonos_addon_data_file:dir create_dir_perms;
allow matonos_addon_manager matonos_addon_data_file:file create_file_perms;
allow matonos_addon_manager vendor_addon_module_file:file { getattr map open read };
get_prop(matonos_addon_manager, exported_default_prop)
# The standard loader reads image-labeled module files through vendor_file_type.
allow vendor_modprobe vendor_addon_module_file:system module_load;
allow matonos_driver_helper matonos_install_block_device:blk_file rw_file_perms;
allow matonos_driver dm_device:blk_file r_file_perms;
allow matonos_driver_helper self:capability sys_admin;
typeattribute matonos_driver_helper vendor_executes_system_violators;
allow matonos_driver_helper system_file:file { execute execute_no_trans getattr map open read };
allow matonos_driver_helper system_file:dir r_dir_perms;

# (No audio HAL of ours: BayLibre generic AIDL HAL runs as hal_audio_default.)


# PipeWire stack and proxy.
allow matonos_driver proc_asound:dir r_dir_perms;
allow matonos_driver proc_asound:file r_file_perms;
allow matonos_driver self:capability { setuid setgid sys_nice };
allow matonos_driver self:process { fork sigchld setsched };
allow matonos_driver matonos_driver_data_file:dir create_dir_perms;
allow matonos_driver matonos_driver_data_file:sock_file create_file_perms;
# Sockets are the process's own objects; the socket FILE lives in
# matonos_driver_data_file (/data/vendor/maton-audio).
allow matonos_driver self:unix_stream_socket create_stream_socket_perms;
allow matonos_driver matonos_driver_data_file:dir rw_dir_perms;
allow matonos_driver matonos_driver_data_file:file rw_file_perms;
allow matonos_driver self:unix_stream_socket connectto;
# The stock audio HAL may connect to the PipeWire proxy socket.
allow hal_audio_default matonos_driver_data_file:dir search;
allow hal_audio_default matonos_driver_data_file:file r_file_perms;
allow hal_audio_default matonos_driver_data_file:sock_file write;
allow hal_audio_default matonos_driver:unix_stream_socket connectto;

# USB, HCI, rfkill and hotplug discovery used by Bluetooth and Wi-Fi drivers.
type matonos_rfkill_device, dev_type;
type matonos_vhci_device, dev_type;
# DRM nodes are created dynamically by whichever PCI/display drivers exist.
# Keep render access on Android's existing GPU device type; cards retain the
# graphics-device type so the stock composer policy continues to apply.
allow matonos_driver matonos_rfkill_device:chr_file rw_file_perms;
# AOSP's Linux Bluetooth HAL uses the MGMT channel to unblock rfkill before
# opening the controller's standard HCI user channel.
allow hal_bluetooth_default matonos_rfkill_device:chr_file rw_file_perms;
allow matonos_driver matonos_vhci_device:chr_file rw_file_perms;
allow matonos_driver self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow matonos_driver sysfs:dir r_dir_perms;
allow matonos_driver sysfs:file r_file_perms;
allow matonos_driver sysfs:lnk_file r_file_perms;
r_dir_file(matonos_driver, sysfs_net)
r_dir_file(matonos_driver, sysfs_type)
# matonos_driver is a HAL server (hal_bootctl) and
# system/sepolicy/private/hal_neverallows.te forbids halserverdomain from
# udp_socket/net_admin. The wifi-simplify change removed driver-owned interface
# rename/link-flag management, so these were dead; they had only been tolerated
# while this domain also carried the exempt hal_bluetooth_server. Dropped.

# Input merger and sleep manager.
allow matonos_driver input_device:dir r_dir_perms;
allow matonos_driver input_device:chr_file rw_file_perms;
allow matonos_driver uhid_device:chr_file { getattr open read write ioctl };
allow matonos_driver sysfs_power:file rw_file_perms;

# Stable Binder channel is the only cross-partition control path.
# The shared driver domain owns hardware-facing channel instances. The system
# bridge is the only client granted service-manager find access.
allow matonos_driver matonos_channel_service:service_manager add;
# addons has a separate narrowly scoped settings channel.
allow matonos_addon_manager matonos_channel_service:service_manager add;
neverallow { domain -matonos_driver -matonos_addon_manager } matonos_channel_service:service_manager add;
binder_call(matonos_driver, matonos_system_bridge)

# The add-on manager writes only intake/extraction files while they carry the
# data label. init restorecon assigns immutable vendor labels before loading.
allow matonos_addon_manager matonos_addon_data_file:dir create_dir_perms;
allow matonos_addon_manager matonos_addon_data_file:file create_file_perms;
allow matonos_addon_manager matonos_addon_data_file:lnk_file create_file_perms;
allow matonos_addon_manager vendor_file_type:dir r_dir_perms;
allow matonos_addon_manager vendor_file_type:file { getattr map open read };
# The firmware lookup tree and links are read-only image contents.
# Bounded modprobe children are reaped or terminated after their timeout.
allow matonos_addon_manager self:process { fork sigchld signal };
binder_call(matonos_addon_manager, matonos_system_bridge)
domain_auto_trans(matonos_addon_manager, vendor_toolbox_exec, vendor_modprobe)
binder_use(matonos_addon_manager)
# modprobe inherits the launcher's standard descriptors across its domain
# transition (stdout/stderr and the module request pipe).
allow vendor_modprobe matonos_driver:fd use;

# addons: init creates optional mountpoints under /mnt/vendor and overlays
# immutable firmware trees at the kernel's single firmware_class.path.
allow init mnt_vendor_file:dir { create_dir_perms mounton };
allow kernel matonos_addon_firmware_overlay:dir r_dir_perms;
allow kernel matonos_addon_firmware_overlay:file r_file_perms;

# install: the validated disk-installer operations use a dedicated device
# type; the daemon remains in the fixed MatonOS driver domain.
allow matonos_driver proc:lnk_file { getattr read };
r_dir_file(matonos_driver, proc)
allow matonos_driver proc_cmdline:file r_file_perms;
allow matonos_driver proc_swaps:file r_file_perms;


# install: BootControl HAL persists A/B state in misc and changes the
# systemd-boot default on the ESP. It is live-safe: the live image reports one
# slot and does not write either device.
hal_server_domain(matonos_driver, hal_bootctl)
get_prop(matonos_driver, exported_default_prop)

# Read and execute vendor binaries/configuration (including sibling tools).
allow matonos_driver vendor_file:dir r_dir_perms;
allow matonos_driver vendor_file:file { getattr map open read };
allow matonos_driver vendor_configs_file:dir r_dir_perms;
allow matonos_driver vendor_configs_file:file r_file_perms;
allow matonos_driver matonos_driver_exec:file { execute getattr map open read };

# Run the Android kernel-module helper in its narrow privileged module loader
# domain. Audio uses it to preload optional HDA codec modules from /vendor.
domain_auto_trans(matonos_driver, vendor_toolbox_exec, vendor_modprobe)
# nogpu: the early graphics selector has the same narrowly scoped module-loader
# transition when it needs to load the optional vgem render node.
domain_auto_trans(pc_gpu_detect, vendor_toolbox_exec, vendor_modprobe)
# nogpu: Mesa reads its software-rendering choice from vendor.mesa.* properties
# (debug.* is core-owned: vendor domains may never set it — neverallow).
set_prop(pc_gpu_detect, vendor_maton_mesa_prop)

# Stock graphics components open DRM render nodes directly. Labeling them as
# generic device denies those opens on enforcing builds; allow only the
# allocator, composer, SurfaceFlinger and Mesa's GPU SP-HAL domains.
allow hal_graphics_allocator_default gpu_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default graphics_device:dir r_dir_perms;
allow hal_graphics_composer_default graphics_device:chr_file rw_file_perms;
allow hal_graphics_composer_default graphics_device:dir r_dir_perms;
# install: generic DRM composer listens for kernel hotplug events. Without this
# stock HWC cannot initialize on virtio-vga and SurfaceFlinger never starts.
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
# install: drm_hwcomposer's HWC3 path imports buffers through the AIDL minigbm
# allocator. Treat the composer as that HAL's client so it can discover and
# call the allocator on an installed boot as well as the live boot.
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)

# install: the software Gatekeeper APEX also exports ISharedSecret/gatekeeper.
# Its service_contexts entry uses hal_gatekeeper_service because that is the
# service type Gatekeeper may register; keystore needs the matching client
# relationship to discover and call that companion interface.
hal_client_domain(keystore, hal_gatekeeper)
allow surfaceflinger gpu_device:chr_file rw_file_perms;
allow surfaceflinger graphics_device:chr_file rw_file_perms;
allow surfaceflinger graphics_device:dir r_dir_perms;
allow surfaceflinger udmabuf_device:chr_file rw_file_perms;
# Mesa's llvmpipe JIT allocates executable code. AOSP has no neverallow on
# execmem for SurfaceFlinger (only execstack/execheap are globally forbidden).
allow surfaceflinger self:process execmem;
allow gpu_sphal_domain gpu_device:chr_file rw_file_perms;

# Mesa reads vendor.mesa.* options from all graphics clients. The type is
# intentionally vendor_public_prop; make the platform-side readers explicit.
get_prop(surfaceflinger, vendor_maton_mesa_prop)
get_prop(zygote, vendor_maton_mesa_prop)
get_prop(hal_graphics_allocator_default, vendor_maton_mesa_prop)
get_prop(hal_graphics_allocator_default, default_prop)

# The audio HAL's AIDL FMQ memfds are ordinary tmpfs files on this kernel's
# memfd-class path. Give the HAL-created queue objects a private label so the
# HAL can write its shared queues without granting access to global tmpfs.

# One block stat node is read by storaged during its normal disk accounting.
allow storaged sysfs:file r_file_perms;
# The software KeyMint implementation reads Android's public device serial.
get_prop(hal_keymint_default, serialno_prop)

# Init opens the configured UART console and initializes boot-receiver tracing.
allow init serial_device:chr_file rw_file_perms;
allow init debugfs_bootreceiver_tracing:dir write;

# kdevtmpfs creates its standard directories (including /dev/input) while it
# populates devtmpfs. This is directory access only; ueventd applies node labels
# and permissions after creation.
allow kernel device:dir write;

# The live/installed super block is discovered as a physical block node. The
# device context is a dev_type, which stock apexd may stat without block I/O.
allow apexd matonos_install_block_device:blk_file getattr;
allow init matonos_install_block_device:blk_file relabelto;

# Boot audio selector (odm/bin/maton-audio-select.sh): its own small domain,
# NOT a HAL server (HAL servers may neither touch audio_device nor run system
# binaries without a transition; matonos_driver is the Bluetooth HAL server).
# It reads /proc/asound, runs AOSP's system tinymix to max/unmute playback
# controls, and sets vendor.maton.audio.*. Async oneshot; failure is benign.
type matonos_audio_select, domain;
type matonos_audio_select_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(matonos_audio_select)
typeattribute matonos_audio_select vendor_executes_system_violators;
allow matonos_audio_select { shell_exec vendor_shell_exec }:file rx_file_perms;
allow matonos_audio_select vendor_toolbox_exec:file rx_file_perms;
allow matonos_audio_select system_file:file { execute execute_no_trans getattr map open read };
allow matonos_audio_select audio_device:dir r_dir_perms;
allow matonos_audio_select audio_device:chr_file rw_file_perms;
allow matonos_audio_select proc_asound:dir r_dir_perms;
allow matonos_audio_select proc_asound:file r_file_perms;
set_prop(matonos_audio_select, vendor_maton_prop)

# Every vendor.maton.* property has one type. The driver owns writes; platform
# readers are explicitly listed to keep the cross-partition boundary narrow.
set_prop(matonos_driver, vendor_maton_prop)
get_prop(matonos_driver, vendor_maton_prop)
get_prop(system_server, vendor_maton_prop)
get_prop(hal_audio_default, vendor_maton_prop)
get_prop(matonos_system_bridge, vendor_maton_prop)
