# Payloads use the stub UID; DAC gates the controller grant.
allow matonos_flatpak_app { hidraw_device uhid_device }:chr_file { getattr open read write ioctl };
# HID feature/report operations (H) and uinput device setup/event operations (U).
allowxperm matonos_flatpak_app hidraw_device:chr_file ioctl { 0x4800-0x48ff };
allowxperm matonos_flatpak_app uhid_device:chr_file ioctl { 0x5500-0x55ff };

# Verify the bridge UID via the existing platform permission Binder service.
binder_call(matonos_linuxd, system_server)
allow matonos_linuxd permission_service:service_manager find;
