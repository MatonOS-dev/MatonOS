# pc-gpu-detect.sh: runs synchronously at early-init to publish GPU summary
# properties and select the Vulkan HAL before graphics services start.
type pc_gpu_detect, domain;
type pc_gpu_detect_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(pc_gpu_detect)
typeattribute pc_gpu_detect matonos_daemon_zone;
typeattribute pc_gpu_detect matonos_hw_reader;

allow pc_gpu_detect vendor_shell_exec:file rx_file_perms;
allow pc_gpu_detect vendor_toolbox_exec:file rx_file_perms;
allow pc_gpu_detect vendor_file:dir r_dir_perms;
allow pc_gpu_detect vendor_file:file { getattr execute execute_no_trans map open read };
# /vendor/etc/intel_vulkan_pci_ids.txt
r_dir_file(pc_gpu_detect, vendor_configs_file)
# The detector publishes boot-time GPU/Vulkan selection; init copies the
# Vulkan choice to ro.hardware.vulkan because only init may set that property.
set_prop(pc_gpu_detect, vendor_maton_prop)
set_prop(pc_gpu_detect, vendor_maton_mesa_prop)

# PCI GPU metadata nodes are labelled sysfs_gpu; only this detector receives
# access to them. Other graphics clients consume its vendor properties.
r_dir_file(pc_gpu_detect, sysfs_gpu)
