// SPDX-License-Identifier: Apache-2.0
//
// MatonOS preinstalled apps. APKs are fetched from F-Droid.
// The keyboard stays AOSP's LatinIME: HeliBoard only declares a
// locale-less subtype until first launch, so the framework never enables it
// as the default IME on a fresh device.
//
// APKs come from tools/fetch-apps.sh (pinned in apps.lock, hash- and
// signer-checked) into apks/ (git-ignored).
// Soong does not re-sign preprocessed imports; dexpreopt stays enabled.
// `overrides` drops the AOSP app each one replaces.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// android_app_import has no defaults module type, so each module repeats
// product_specific and preprocessed. Dex preopt stays on (boot speed).
// skip_preprocessed_apk_checks: only on APKs that fail Soong's checks
// (compressed JNI libraries; for priv-apps also compressed dex), since Soong
// rejects it elsewhere; tools/fetch-apps.sh checks it matches.

// Empty, versionCode 1 package reservations allow stores to offer their
// upstream signed packages as updates. The signer transitions are pinned in
// patches/frameworks/base/0003-pinned-gms-update.patch.
android_app_import {
    name: "MatonAuroraPlaceholder",
    apk: "placeholders/com.aurora.store.apk",
    product_specific: true,
    privileged: true,
    preprocessed: true,
    // Package reservation only: this manifest-only APK contains no classes.dex.
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-com.aurora.store.xml"],
}

android_app_import {
    name: "MatonYoutubePlaceholder",
    apk: "placeholders/com.google.android.youtube.apk",
    product_specific: true,
    privileged: true,
    preprocessed: true,
    // Package reservation only: this manifest-only APK contains no classes.dex.
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-com.aurora.store.xml",
    src: "privapp-permissions-com.aurora.store.xml",
    sub_dir: "permissions",
    product_specific: true,
}

android_app_import {
    name: "MatonFennec",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "apks/MatonFennec.apk",
    product_specific: true,
    preprocessed: true,
    skip_preprocessed_apk_checks: true,
    // QuickSearchBox (web search widget) goes with the AOSP browser.
    overrides: [
        "Browser2",
        "QuickSearchBox",
    ],
}

android_app_import {
    name: "MatonFossifyGallery",
    apk: "apks/MatonFossifyGallery.apk",
    product_specific: true,
    preprocessed: true,
    overrides: ["Gallery2"],
}

android_app_import {
    name: "MatonFossifyCalendar",
    apk: "apks/MatonFossifyCalendar.apk",
    product_specific: true,
    preprocessed: true,
    overrides: ["Calendar"],
}

// Also drops the phone apps: PCs have no modem (Dialer, Messaging).
android_app_import {
    name: "MatonFossifyContacts",
    apk: "apks/MatonFossifyContacts.apk",
    product_specific: true,
    preprocessed: true,
    overrides: [
        "Contacts",
        "Dialer",
        "messaging",
    ],
}

android_app_import {
    name: "MatonFossifyClock",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "apks/MatonFossifyClock.apk",
    product_specific: true,
    preprocessed: true,
    overrides: ["DeskClock"],
}

android_app_import {
    name: "MatonFossifyNotes",
    apk: "apks/MatonFossifyNotes.apk",
    product_specific: true,
    preprocessed: true,
}

android_app_import {
    name: "MatonFossifyCalculator",
    apk: "apks/MatonFossifyCalculator.apk",
    product_specific: true,
    preprocessed: true,
}

android_app_import {
    name: "MatonFossifyMusicPlayer",
    apk: "apks/MatonFossifyMusicPlayer.apk",
    product_specific: true,
    preprocessed: true,
    overrides: ["Music"],
}

android_app_import {
    name: "MatonOpenCamera",
    apk: "apks/MatonOpenCamera.apk",
    product_specific: true,
    preprocessed: true,
    overrides: ["Camera2"],
}
