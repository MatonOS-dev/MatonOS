<permissions>
    <privapp-permissions package="org.matonos.systembridge">
        <permission name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.WRITE_SETTINGS" />
        <permission name="android.permission.MANAGE_APP_OPS_MODES" />
        <!-- sleep: PowerManager wake-lock dump; system-wide playback state. -->
        <permission name="android.permission.DUMP" />
        <permission name="android.permission.MODIFY_AUDIO_ROUTING" />
        <!-- input: per-user pointer settings (USER_CURRENT). -->
        <permission name="android.permission.MANAGE_USERS" />
        <!-- setup: locale and time-zone controls are signature|privileged. -->
        <permission name="android.permission.CHANGE_CONFIGURATION" />
        <permission name="android.permission.SET_TIME_ZONE" />
        <permission name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
        <!-- btd: privileged controller enable/disable around driver selection. -->
        <permission name="android.permission.BLUETOOTH_PRIVILEGED" />
    </privapp-permissions>
</permissions>
