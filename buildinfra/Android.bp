// Fixed stable Binder contract shared by the system bridge and vendor NDK daemons.
aidl_interface {
    name: "vendor.matonos.channel",
    vendor_available: true,
    srcs: ["channel/aidl/**/*.aidl"],
    local_include_dir: "channel/aidl",
    stability: "vintf",
    backend: {
        java: {
            platform_apis: true,
        },
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
        rust: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
}

// Driver executables and libmatonos-ipc live in the ODM image built outside
// Soong by tools/build-bundle.sh. Apps below remain fixed Soong imports.

android_app_import {
    name: "MatonOSSettings",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "apps-built/Settings.apk",
    system_ext_specific: true,
    privileged: true,
    // Keep the APK byte-for-byte so the package retains its own app key.
    preprocessed: true,
    required: ["privapp-permissions-org.matonos.settings"],
}

android_app_import {
    name: "MatonOSFlathub",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "apps-built/Flathub.apk",
    system_ext_specific: true,
    privileged: true,
    // Keep the APK byte-for-byte so the package retains its own app key.
    preprocessed: true,
    required: ["privapp-permissions-org.matonos.flathub"],
}

android_app_import {
    name: "MatonOSRecents",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "apps-built/MatonOSRecents.apk",
    system_ext_specific: true,
    privileged: true,
    preprocessed: true,
    required: ["privapp-permissions-org.matonos.recents"],
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.settings",
    src: "privapp-permissions/privapp-permissions-org.matonos.settings.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.flathub",
    src: "privapp-permissions/privapp-permissions-org.matonos.flathub.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.recents",
    src: "privapp-permissions/privapp-permissions-org.matonos.recents.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.compositor",
    src: "privapp-permissions/privapp-permissions-org.matonos.compositor.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.systembridge",
    src: "privapp-permissions/privapp-permissions-org.matonos.systembridge.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

// compositor: v4 Wayland compositor host app (Java). Its native libraries
// (wlroots, wayland, pixman, xkbcommon, libdrm, libmaton_compositor) are
// packaged inside the APK by linux/compositor/build-compositor.sh + Gradle.
android_app_import {
    name: "MatonWaylandHost",
    privileged: true,
    required: [
        "privapp-permissions-org.matonos.compositor",
        "matonos-apk-session-broker",
    ],
    apk: "apps-built/MatonWaylandHost.apk",
    system_ext_specific: true,
    preprocessed: true,
    // build-apps.sh stores and aligns JNI/dex before signing. System apps do
    // not get PM extraction; JNI loads from the APK and the broker is below.
}

// Derive the image executable from the imported APK, never a separately built
// broker. preprocessed keeps that APK byte-for-byte, including its signature.
genrule {
    name: "matonos-apk-session-broker-extract",
    srcs: ["apps-built/MatonWaylandHost.apk"],
    tools: ["matonos-extract-apk-broker"],
    out: ["matonos-apk-session-broker"],
    cmd: "$(location matonos-extract-apk-broker) $(in) $(out)",
}

python_binary_host {
    name: "matonos-extract-apk-broker",
    main: "extract-apk-broker.py",
    srcs: ["extract-apk-broker.py"],
}

prebuilt_bin {
    name: "matonos-apk-session-broker",
    src: ":matonos-apk-session-broker-extract",
    system_ext_specific: true,
}
