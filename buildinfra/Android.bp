// Fixed stable Binder contract shared by the system bridge and vendor NDK daemons.
aidl_interface {
    name: "vendor.matonos.channel",
    vendor_available: true,
    srcs: ["channel/aidl/**/*.aidl"],
    local_include_dir: "channel/aidl",
    stability: "vintf",
    backend: {
        java: {
            platform_apis: true,
        },
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
        rust: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
}

// Driver executables and libmatonos-ipc live in the ODM image built outside
// Soong by tools/build-bundle.sh. Apps below remain fixed Soong imports.

android_app_import {
    name: "MatonOSSettings",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "apps-built/Settings.apk",
    system_ext_specific: true,
    privileged: true,
    // Keep the APK byte-for-byte so the package retains its own app key.
    preprocessed: true,
    required: ["privapp-permissions-org.matonos.settings"],
}

android_app_import {
    name: "MatonOSFlathub",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "apps-built/Flathub.apk",
    system_ext_specific: true,
    privileged: true,
    // Keep the APK byte-for-byte so the package retains its own app key.
    preprocessed: true,
    required: ["privapp-permissions-org.matonos.flathub"],
}

android_app_import {
    name: "MatonOSRecents",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "apps-built/MatonOSRecents.apk",
    system_ext_specific: true,
    privileged: true,
    preprocessed: true,
    required: ["privapp-permissions-org.matonos.recents"],
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.settings",
    src: "privapp-permissions/privapp-permissions-org.matonos.settings.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.flathub",
    src: "privapp-permissions/privapp-permissions-org.matonos.flathub.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.recents",
    src: "privapp-permissions/privapp-permissions-org.matonos.recents.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.linux",
    src: "privapp-permissions/privapp-permissions-org.matonos.linux.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.systembridge",
    src: "privapp-permissions/privapp-permissions-org.matonos.systembridge.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

// compositor: v4 Wayland compositor host app (Java). Its native libraries
// (wlroots, wayland, pixman, xkbcommon, libdrm, libmaton_compositor) are
// packaged inside the APK by linux/subsystem/build-compositor.sh + Gradle.
android_app_import {
    name: "MatonLinuxSubsystem",
    privileged: true,
    required: [
        "privapp-permissions-org.matonos.linux",
    ],
    apk: "apps-built/MatonLinuxSubsystem.apk",
    system_ext_specific: true,
    preprocessed: true,
    // build-apps.sh stores and aligns JNI/dex before signing. System apps do
    // not get PM extraction; JNI loads from the APK.
    //
    // WARNING: generated Flatpak stubs load the host through
    // org.matonos.linux.stub.StubLoader, which hard-codes this module's
    // install path (/system_ext/priv-app/MatonLinuxSubsystem/MatonLinuxSubsystem.apk)
    // and the stored, uncompressed JNI layout (apk!/lib/<abi>). Renaming the
    // module, changing its partition, dropping `privileged` or compressing the
    // JNI libraries silently disables StubLoader; update StubLoader.SYSTEM_APK
    // with any such change.
}

// The session broker is a JNI library loaded inside each app's own process
// (lib/x86_64/libmatonos-dbus-broker.so in the APK). There is no standalone
// /system_ext/bin broker; the per-app runtime never runs it as a process.
