// Fixed stable Binder contract shared by the system bridge and vendor NDK daemons.
aidl_interface {
    name: "vendor.matonos.channel",
    vendor_available: true,
    srcs: ["channel/aidl/**/*.aidl"],
    local_include_dir: "channel/aidl",
    stability: "vintf",
    backend: {
        java: {
            platform_apis: true,
        },
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
        rust: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
}

// Driver executables and libmatonos-ipc live in the ODM image built outside
// Soong by tools/build-bundle.sh. Apps below remain fixed Soong imports.

android_app_import {
    name: "MatonOSSettings",
    apk: "apps-built/Settings.apk",
    system_ext_specific: true,
    privileged: true,
    // Keep the APK byte-for-byte so the package retains its own app key.
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-org.matonos.settings"],
}

android_app_import {
    name: "MatonOSShell",
    apk: "apps-built/MatonOSShell.apk",
    system_ext_specific: true,
    privileged: true,
    // Keep the APK byte-for-byte so the package retains its own app key.
    preprocessed: true,
    overrides: [
        "Home",
        "Launcher2",
        "Launcher3",
        "Launcher3QuickStep",
    ],
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-org.matonos.shell"],
}

android_app_import {
    name: "MatonOSShelf",
    apk: "apps-built/MatonOSShelf.apk",
    system_ext_specific: true,
    privileged: true,
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-org.matonos.shelf"],
}

android_app_import {
    name: "MatonOSRecents",
    apk: "apps-built/MatonOSRecents.apk",
    system_ext_specific: true,
    privileged: true,
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-org.matonos.recents"],
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.settings",
    src: "privapp-permissions/privapp-permissions-org.matonos.settings.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.shell",
    src: "privapp-permissions/privapp-permissions-org.matonos.shell.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.shelf",
    src: "privapp-permissions/privapp-permissions-org.matonos.shelf.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.recents",
    src: "privapp-permissions/privapp-permissions-org.matonos.recents.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-org.matonos.systembridge",
    src: "privapp-permissions/privapp-permissions-org.matonos.systembridge.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
