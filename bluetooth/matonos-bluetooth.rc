# No controller at boot: declare Bluetooth unavailable before system_server reads
# its features (matonos-bt-detect.sh). exec_start blocks init until it exits.
on post-fs-data
    exec_start vendor.matonos-bt-detect

service vendor.matonos-bt-detect /odm/bin/matonos-bt-detect.sh
    class core
    user root
    group root
    oneshot
    disabled
    stdio_to_kmsg
    timeout_period 5

# The generic Linux HCI HAL needs AF_BLUETOOTH and /dev/rfkill. Both are modules
# (CONFIG_BT=m, CONFIG_RFKILL=m) that only load when an adapter driver such as
# btusb probes. Load them so the HAL starts even before such a driver.
on early-boot
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules rfkill bluetooth
