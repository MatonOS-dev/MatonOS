service matonos-btd /odm/bin/matonos-btd
    class core
    setenv LD_LIBRARY_PATH /odm/lib64
    user root
    group root
    disabled
    # Persistent manager tracks hotplug and persisted selection.

# Vendor modules are available only after mount_all --early.
on post-fs
    insmod /vendor/lib/modules/rfkill.ko
    insmod /vendor/lib/modules/bluetooth.ko
    insmod /vendor/lib/modules/hci_vhci.ko
    start matonos-btd

