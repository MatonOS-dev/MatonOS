package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

sh_binary {
    name: "pc-gpu-detect.sh",
    src: "pc-gpu-detect.sh",
    vendor: true,
}

prebuilt_etc {
    name: "init.pc_x86_64.graphics.rc",
    src: "init.pc_x86_64.graphics.rc",
    relative_install_path: "init",
    vendor: true,
}

// Installs the vendor variants of the libraries the copied Mesa prebuilts
// need in the sphal namespace, for both ABIs (32-bit: i386 GPU bridge).
cc_library_shared {
    name: "libmaton_mesa_sphal_deps",
    vendor: true,
    compile_multilib: "both",
    srcs: ["sphal-deps/sphal_deps.c"],
    shared_libs: ["libhardware"],
}
