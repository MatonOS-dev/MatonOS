// Linux subsystem bootstrap (org.matonos.linux, versionCode 1). It contains the
// real signed subsystem APK, built by the standalone linux-subsystem-app
// repository, and installs it over itself on first boot (and after "uninstall
// updates"); updates then come from our F-Droid repo. The bootstrap has no
// native code; the installed /data copy gets PackageManager lib extraction.
// Image/policy changes must keep working with the previously shipped subsystem.
android_app_import {
    name: "MatonLinuxSubsystem",
    privileged: true,
    required: [
        "privapp-permissions-org.matonos.linux",
    ],
    apk: "prebuilt/linux-subsystem/MatonLinuxSubsystemBootstrap.apk",
    system_ext_specific: true,
    preprocessed: true,
}
