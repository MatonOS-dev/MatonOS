# Public: declaration only (vendor policy in sepolicy/matonos references it).
# app_domain() emits type transitions, which public policy may not contain;
# it lives in ../private/matonos_system_bridge.te.
type matonos_system_bridge, domain;

# Public PCI identity only: vendor HALs and platform Mesa clients share it.
# No config/resource/modalias/uevent files and no writable hardware controls.
type sysfs_matonos_pci_id, fs_type, sysfs_type;
type ntsync_device, dev_type, mlstrustedobject;
