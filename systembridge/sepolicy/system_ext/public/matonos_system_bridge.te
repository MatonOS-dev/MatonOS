# Public: declaration only (vendor policy in sepolicy/matonos references it).
# app_domain() emits type transitions, which public policy may not contain;
# it lives in ../private/matonos_system_bridge.te.
type matonos_system_bridge, domain;

# Public declarations let fixed vendor file_contexts map this system_ext
# executable and private /data tree without adding policy files.
type matonos_linuxd_exec, exec_type, file_type, system_file_type;
type matonos_flatpak_data_file, file_type, data_file_type, core_data_file_type;

# Shared boundary attributes and service labels: visible to both platform and vendor policy.
attribute matonos_daemon_zone;
attribute matonos_raw_hardware_type;
attribute matonos_daemon_socket_file;
type matonos_channel_service, protected_service, hal_service_type, service_manager_type;
type sysfs_matonos_sensitive, fs_type, sysfs_type;
type matonos_addon_mount_file, file_type, vendor_file_type;
