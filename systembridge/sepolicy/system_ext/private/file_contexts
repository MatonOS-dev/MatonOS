# linuxd: system-side Flatpak service (Treble: platform files are labelled by
# platform-side policy, never by vendor file_contexts).
/system_ext/bin/matonos-linuxd u:object_r:matonos_linuxd_exec:s0
/data/matonos/linux(/.*)? u:object_r:matonos_flatpak_data_file:s0
# r24 code/runtime image store. The image files and their mount points are
# data; the *contents* of a mounted image are labelled only by the mount's
# context= (matonos_(app_code|runtime)_exec), never by this directory.
/data/matonos/linux/store(/.*)? u:object_r:matonos_flatpak_store_file:s0
# Per-app Xwayland display sockets live in their own directory so the
# compositor can hand each socket to its application's uid.
# r24: the Flatpak runtime files (flatpak/gpg/ostree/revokefs-fuse, the Flatpak
# libraries and share/flatpak triggers) and Xwayland are no longer here:
# Flatpak now lives in the com.matonos.flatpak APEX, which supplies its own
# file_contexts, and Xwayland keeps the default system_file label.

# linuxd's sysfs metadata only. Canonical /devices paths cover every bus and
# hotplug topology; ueventd restorecon does not follow /class symlinks.
/sys/devices(/[^/]+)*/input[0-9]+/(capabilities|id) -d u:object_r:sysfs_matonos_input:s0
/sys/devices(/[^/]+)*/input[0-9]+/capabilities/(ev|key|abs|rel) -- u:object_r:sysfs_matonos_input:s0
/sys/devices(/[^/]+)*/input[0-9]+/properties -- u:object_r:sysfs_matonos_input:s0
/sys/devices(/[^/]+)*/input[0-9]+/id/(vendor|product|bustype) -- u:object_r:sysfs_matonos_input:s0
/sys/devices(/[^/]+)*/input[0-9]+/(event|js)[0-9]+/dev -- u:object_r:sysfs_matonos_input:s0
/sys/devices(/[^/]+)*/hidraw/hidraw[0-9]+/dev -- u:object_r:sysfs_matonos_input:s0
# Linux HID device names are bus:vendor:product.instance (uppercase hex).
# The instance can exceed four digits; only this device's uevent is readable.
/sys/devices(/[^/]+)*/[0-9A-Fa-f]{4}:[0-9A-Fa-f]{4}:[0-9A-Fa-f]{4}\.[0-9A-Fa-f]+/uevent -- u:object_r:sysfs_matonos_input:s0
/sys/devices/virtual/misc/uinput/dev -- u:object_r:sysfs_matonos_input:s0

/data/matonos/linux/apps/[0-9]+(/.*)? u:object_r:matonos_linux_data_file:s0
/data/matonos/linux/flatpak(/.*)? u:object_r:matonos_flatpak_deployment_file:s0
/data/matonos/linux/runtime(/.*)? u:object_r:matonos_flatpak_socket_file:s0
/data/matonos/linux/(machine-id|udev)(/.*)? u:object_r:matonos_flatpak_deployment_file:s0

# r24: the Flatpak CLI, installer helper, bwrap layers and app launcher moved
# into the com.matonos.flatpak APEX. Their exec types are applied by
# linux/flatpak/apex_file_contexts at /apex/com.matonos.flatpak/bin.

/data/matonos/linux/cache/launch-[^/]+\.log u:object_r:matonos_flatpak_log_file:s0
