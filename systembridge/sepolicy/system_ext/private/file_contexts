# linuxd: system-side Flatpak service (Treble: platform files are labelled by
# platform-side policy, never by vendor file_contexts).
/system_ext/bin/matonos-linuxd u:object_r:matonos_linuxd_exec:s0
/dev/ntsync u:object_r:ntsync_device:s0

# linux-app: generic first, more specific entries last for equal fixed stems.
/data/linux-app(/.*)? u:object_r:matonos_flatpak_deployment_file:s0
/data/linux-app/staging(/.*)? u:object_r:matonos_flatpak_staging_file:s0
/data/linux-app/(install/[0-9]+-[A-Za-z0-9]+|runtime)/repo/objects(/.*)? u:object_r:matonos_linux_code_file:s0
