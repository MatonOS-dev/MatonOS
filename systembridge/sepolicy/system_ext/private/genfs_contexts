# Read-only boot memory accounting and namespace setup metadata.
genfscon sysfs /kernel/mm/ksm u:object_r:sysfs_matonos_ksm:s0
genfscon sysfs /devices/virtual/dmi/id/product_name u:object_r:sysfs_matonos_product_name:s0
# Public manufacturer metadata queried by the in-app compositor; no serials.
genfscon sysfs /devices/virtual/dmi/id/sys_vendor u:object_r:sysfs_matonos_product_name:s0
