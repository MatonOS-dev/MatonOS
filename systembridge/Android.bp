// The bridge is the only MatonOS app built inside Soong: it needs platform
// APIs and the platform certificate. Keep its source/API file set stable.
android_app {
    name: "MatonSystemBridge",
    manifest: "AndroidManifest.xml",
    srcs: [
        "src/**/*.java",
    ],
    resource_dirs: ["res"],
    aidl: {
        local_include_dirs: [
            "aidl",
        ],
    },
    platform_apis: true,
    static_libs: [
        "matonos-client-java",
    ],
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    // Desktop app selection: suppress these inherited AOSP UI apps.
    // Providers, ContactsPicker and the framework's telephony services remain.
    overrides: [
        "Calendar",
        "Contacts",
        "DeskClock",
        "Dialer",
        "messaging",
        "Music",
    ],
    required: [
        "privapp-permissions-org.matonos.systembridge",
        "default-permissions-org.matonos.systembridge.xml",
    ],
}

prebuilt_etc {
    name: "default-permissions-org.matonos.systembridge.xml",
    src: "default-permissions-org.matonos.systembridge.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}

java_library_static {
    name: "matonos-systembridge-aidl-java",
    srcs: ["aidl/**/*.aidl"],
    aidl: {
        local_include_dirs: ["aidl"],
    },
    platform_apis: true,
}

java_test_host {
    name: "MatonSystemBridgeAuthorizationTests",
    srcs: [
        "src/org/matonos/systembridge/BridgeCallerIdentity.java",
        "tests/src/**/*.java",
    ],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
}
