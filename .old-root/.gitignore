# MatonOS mono-repo at the AOSP checkout root. Whitelist: ignore the AOSP tree,
# allow only MatonOS paths, then drop build outputs/downloads/keys inside them.
/*
!/.gitignore
!/README.md
!/CONTRIBUTE.md
!/LICENSE
!/forks/
!/apps/
!/device/
/device/*
!/device/maton/

# --- generic build outputs, caches, secrets (anywhere below) ---
node_modules/
build/
.gradle/
.cxx/
.kotlin/
.expo/
.metro-health-check*
*.apk
*.aab
*.jks
*.keystore
*.pass
*.pk8
local.properties
framework-stubs.jar
*.log
.DS_Store

# --- Expo CNG: android/ is generated by `expo prebuild` ---
/apps/launchme/android/
/apps/shelf/android/
/apps/recents/android/
/apps/launchme/legacy-gradle/build/

# --- device tree: staged binaries and downloads (rebuilt/fetched by tools/) ---
/device/maton/pc_x86_64/prebuilt/
/device/maton/pc_x86_64/apps/apks/
/device/maton/pc_x86_64/buildinfra/apps-built/
/device/maton/pc_x86_64/buildinfra/native-built/
/device/maton/pc_x86_64/bootanim/out/
/device/maton/pc_x86_64/bootwatch/out/
/device/maton/pc_x86_64/tools/payload/
/device/maton/pc_x86_64/audio/native-hal/deps/
/device/maton/pc_x86_64/**/libs/*.jar

# Pristine upstream sources for the Linux-apps stack (fetched, not committed)
/device/maton/pc_x86_64/linux/third_party/*/upstream/
