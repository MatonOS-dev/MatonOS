{
  "name": "matonos-settings",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --port 8084",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src app --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"index.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"index.js\"",
    "check:release-linkage": "node scripts/check-release-linkage.mjs"
  },
  "dependencies": {
    "@expo/ui": "57.0.20",
    "expo": "57.0.25",
    "expo-dev-client": "57.0.19",
    "expo-font": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.13",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": "22.x",
    "npm": "9.x"
  }
}
