<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application>
        <activity
            android:name="org.matonos.settings.nativebridge.MediaVolumeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="org.matonos.settings.nativebridge.MediaVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_media_volume"
            android:label="@string/media_volume_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
