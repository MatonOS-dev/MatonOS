<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="org.matonos.permission.BIND_EMBEDDED_SETTINGS" />
    <uses-permission android:name="org.matonos.permission.BIND_CAPTION_PROVIDER" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <queries>
        <intent><action android:name="org.matonos.appsettings.EMBEDDED_SETTINGS" /></intent>
        <intent><action android:name="org.matonos.tray.HOST" /></intent>
    </queries>
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REBOOT" />
    <application>
        <activity
            android:name="org.matonos.settings.AccountFlowActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="org.matonos.settings.nativebridge.AccountAuthenticatorService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/maton_account_authenticator" />
        </service>
        <activity
            android:name="org.matonos.settings.nativebridge.MediaVolumeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="org.matonos.settings.nativebridge.MediaVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_media_volume"
            android:label="@string/media_volume_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name="org.matonos.settings.nativebridge.VolumeBoostService"
            android:exported="false" />
    </application>
</manifest>
