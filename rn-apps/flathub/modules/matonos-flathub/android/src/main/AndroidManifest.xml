<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="org.matonos.permission.QUERY_LINUX_APPS" />
  <uses-permission android:name="org.matonos.permission.INSTALL_LINUX_APPS" />
  <!-- Lets the store find generated Flatpak stubs' "install me" activities. -->
  <queries>
    <intent>
      <action android:name="org.matonos.linuxhost.INSTALL" />
    </intent>
  </queries>
</manifest>
