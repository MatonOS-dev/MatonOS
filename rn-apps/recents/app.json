{
  "expo": {
    "name": "MatonOS Recents",
    "slug": "matonos-recents",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "org.matonos.recents",
      "versionCode": 1,
      "permissions": ["QUERY_ALL_PACKAGES", "org.matonos.permission.SYSTEM_BRIDGE"]
    },
    "plugins": ["./plugins/withMatonRecents"],
    "experiments": {"autolinkingModuleResolution": true},
    "autolinking": {"nativeModulesDir": "./modules"}
  }
}
