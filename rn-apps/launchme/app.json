{
  "expo": {
    "name": "MatonOS Shell",
    "slug": "matonos-shell",
    "version": "1.3.0",
    "orientation": "landscape",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "org.matonos.shell",
      "versionCode": 3,
      "permissions": [
        "QUERY_ALL_PACKAGES",
        "org.matonos.permission.SYSTEM_BRIDGE"
      ]
    },
    "plugins": [
      "./plugins/withMatonShell",
      "expo-splash-screen"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
