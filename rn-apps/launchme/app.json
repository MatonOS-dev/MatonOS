{
  "expo": {
    "name": "MatonOS Shell",
    "slug": "matonos-shell",
    "version": "1.3.0",
    "orientation": "landscape",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "org.matonos.shell",
      "versionCode": 3,
      "permissions": ["QUERY_ALL_PACKAGES", "SYSTEM_ALERT_WINDOW", "RECEIVE_BOOT_COMPLETED", "org.matonos.permission.SYSTEM_BRIDGE"]
    },
    "plugins": ["./plugins/withMatonShell"],
    "experiments": {"autolinkingModuleResolution": true},
    "autolinking": {"nativeModulesDir": "./modules"}
  }
}
