{
  "name": "matonos-shell",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"index.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"index.js\"",
    "check:release-linkage": "node scripts/check-release-linkage.mjs"
  },
  "dependencies": {
    "@expo/ui": "57.0.20",
    "@material/material-color-utilities": "0.4.0",
    "@matonos/rn-common": "file:../rn-common",
    "expo": "57.0.25",
    "expo-dev-client": "57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "5.15.3",
    "react-native-safe-area-context": "5.10.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.13",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": "22.x",
    "npm": "9.x"
  }
}
