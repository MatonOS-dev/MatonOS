+std::optional<vec2> CursorInputMapper::absolutePosition() const {
+    if (!mAbsolute || !mAbsX || !mAbsY || mSource != AINPUT_SOURCE_MOUSE) {
+        return std::nullopt;
+    }
+    const FloatRect& b = mBoundsInLogicalDisplay;
+    if (b.right <= b.left || b.bottom <= b.top) {
+        return std::nullopt;
+    }
+    const auto scale = [](int32_t value, const RawAbsoluteAxisInfo& info, float lo, float hi) {
+        const float clamped = std::clamp(value, info.minValue, info.maxValue);
+        return lo + (clamped - info.minValue) * (hi - lo) / (info.maxValue - info.minValue);
+    };
+    return vec2{scale(*mAbsX, *mAbsXInfo, b.left, b.right),
+                scale(*mAbsY, *mAbsYInfo, b.top, b.bottom)};
+}
