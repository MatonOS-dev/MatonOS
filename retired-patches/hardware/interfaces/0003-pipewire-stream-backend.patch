+constexpr char kPipeWireSocketPath[] = "/data/vendor/maton-audio/audio.sock";
+constexpr uint32_t kPipeWireMagic = 0x4d415544;
+constexpr uint32_t kPipeWirePlayback = 0;
+constexpr uint32_t kPipeWireCapture = 1;
+constexpr uint32_t kPipeWirePcmS16Le = 1;
