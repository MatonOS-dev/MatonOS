+bool StreamPrimary::connectPipeWire() {
+    if (mPipeWireSocket >= 0) closePipeWire();
+    if (mFrameSizeBytes != 2 && mFrameSizeBytes != 4) {
+        LOG(ERROR) << "PipeWire bridge supports signed 16-bit PCM with one or two channels";
+        return false;
+    }
+    const int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) return false;
+    const timeval transferTimeout{.tv_sec = 0, .tv_usec = 250000};
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &transferTimeout, sizeof(transferTimeout));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &transferTimeout, sizeof(transferTimeout));
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    strlcpy(address.sun_path, kPipeWireSocketPath, sizeof(address.sun_path));
+    if (connect(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+        close(fd);
+        return false;
+    }
+    const PipeWireRequest request{
+            .magic = kPipeWireMagic,
+            .direction = mIsInput ? kPipeWireCapture : kPipeWirePlayback,
+            .sampleRate = static_cast<uint32_t>(mSampleRate),
+            .channels = static_cast<uint32_t>(mFrameSizeBytes / 2),
+            .format = kPipeWirePcmS16Le,
+    };
+    if (!writePipeWireAll(fd, &request, sizeof(request))) {
+        close(fd);
+        return false;
+    }
+    mPipeWireSocket = fd;
+    return true;
+}
+
+void StreamPrimary::closePipeWire() {
+    if (mPipeWireSocket >= 0) {
+        ::shutdown(mPipeWireSocket, SHUT_RDWR);
+        close(mPipeWireSocket);
+        mPipeWireSocket = -1;
+    }
+    mPipeWireActive = false;
+}
