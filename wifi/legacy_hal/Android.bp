// MatonOS fork of device/generic/goldfish/wifi/wifi_hal: the generic
// nl80211 legacy Wi-Fi HAL backend, used for every card. Wired in through
// a direct call from the Wi-Fi HAL fork (namespace matonos_wifi_emu), so the
// goldfish copy inside libwifi-hal.so stays unused.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libwifi-hal-matonos",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    srcs: [
        "halstate.cpp",
        "info.cpp",
        "interface.cpp",
        "netlink.cpp",
        "netlinkmessage.cpp",
        "wifi_hal.cpp",
    ],
    shared_libs: [
        "libnl",
        "liblog",
        "libcutils",
        "wifi_legacy",
    ],
    export_include_dirs: ["."],
    vendor: true,
}
