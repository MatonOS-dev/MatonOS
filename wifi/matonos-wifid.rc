service vendor.matonos-wifid /odm/bin/matonos-wifid
    class core
    setenv LD_LIBRARY_PATH /odm/lib64
    user root
    group system

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    start vendor.matonos-wifid

# The stock AIDL supplicant expects these vendor-data paths for its config and
# control sockets. It lazily starts after APEX activation, so create them before
# WifiService first requests the supplicant.
# post-fs-data runs before system_server asks for Wi-Fi, regardless of APEX
# activation order.

# One-shot no-radio fallback. The daemon requests this only when its initial
# boot snapshot finds no real phy80211; the module parameter explicitly limits
# the fallback to one empty nl80211 radio. Real adapters never get a phantom.
on property:vendor.maton.wifi.hwsim.load=1
    insmod /vendor/lib/modules/rfkill.ko
    insmod /vendor/lib/modules/cfg80211.ko
    insmod /vendor/lib/modules/libarc4.ko
    insmod /vendor/lib/modules/mac80211.ko
    insmod /vendor/lib/modules/mac80211_hwsim.ko radios=1
    setprop vendor.maton.wifi.present 1
    setprop vendor.maton.wifi.hwsim.load 0
