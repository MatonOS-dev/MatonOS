<?xml version="1.0" encoding="UTF-8"?>
<!--
  MatonOS local manifest. Install with:
    mkdir -p .repo/local_manifests
    curl -o .repo/local_manifests/maton.xml \
      https://raw.githubusercontent.com/MatonOS-dev/MatonOS/main/manifest/maton.xml
    repo sync -c
  Brings in the MatonOS device tree and our forks of AOSP / third-party
  projects (github.com/MatonOS-dev, branch matonos/v1.2).
-->
<manifest>
  <remote name="matonos-dev" fetch="https://github.com/MatonOS-dev" />

  <!-- Device tree (this repository) -->
  <project path="device/maton/pc_x86_64" name="MatonOS" remote="matonos-dev"
           revision="main" />

  <!-- Graphics: minigbm (fork of android-generic's), drm_hwcomposer -->
  <remove-project name="platform/external/minigbm" />
  <project path="external/minigbm" name="android_external_minigbm"
           remote="matonos-dev" revision="matonos/v1.2" />
  <remove-project name="platform/external/drm_hwcomposer" />
  <project path="external/drm_hwcomposer" name="android_external_drm_hwcomposer"
           remote="matonos-dev" revision="matonos/v1.2" />

  <!-- Dependency bumps for wlroots -->
  <remove-project name="platform/external/libdrm" />
  <project path="external/libdrm" name="android_external_libdrm"
           remote="matonos-dev" revision="matonos/v1.2" />
  <remove-project name="platform/external/libxkbcommon" />
  <project path="external/libxkbcommon" name="android_external_libxkbcommon"
           remote="matonos-dev" revision="matonos/v1.2" />
  <remove-project name="platform/external/pixman" />
  <project path="external/pixman" name="android_external_pixman"
           remote="matonos-dev" revision="matonos/v1.2" />
  <remove-project name="platform/external/wayland" />
  <project path="external/wayland" name="android_external_wayland"
           remote="matonos-dev" revision="matonos/v1.2" />
  <remove-project name="platform/external/wayland-protocols" />
  <project path="external/wayland-protocols" name="android_external_wayland-protocols"
           remote="matonos-dev" revision="matonos/v1.2" />

  <!-- Audio HAL: BayLibre's generic AIDL HAL (fork, + IModule V4 fixes) -->
  <project path="hardware/baylibre/audio" name="android_hardware_baylibre_audio"
           remote="matonos-dev" revision="matonos/v1.2" />

  <!-- Linux apps (Flatpak on bionic): patched components, nested inside the
       device tree where linux/third_party/<name>/Android.bp expects them -->
  <project path="device/maton/pc_x86_64/linux/third_party/flatpak/upstream" name="flatpak"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/ostree/upstream" name="ostree"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/bubblewrap/upstream" name="bubblewrap"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/glib/upstream" name="glib"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/gnupg/upstream" name="gnupg"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/npth/upstream" name="npth"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libgpg-error/upstream" name="libgpg-error"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libfyaml/upstream" name="libfyaml"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/appstream/upstream" name="appstream"
           remote="matonos-dev" revision="matonos/v1.2" />
  <!-- Linux apps: unmodified release snapshots (tested tarballs incl. generated files) -->
  <project path="device/maton/pc_x86_64/linux/third_party/gdk-pixbuf/upstream" name="gdk-pixbuf"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/gpgme/upstream" name="gpgme"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/json-glib/upstream" name="json-glib"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libarchive/upstream" name="libarchive"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libassuan/upstream" name="libassuan"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libgcrypt/upstream" name="libgcrypt"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libjpeg-turbo/upstream" name="libjpeg-turbo"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libksba/upstream" name="libksba"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/liblzma/upstream" name="liblzma"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libpng/upstream" name="libpng"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libseccomp/upstream" name="libseccomp"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libxmlb/upstream" name="libxmlb"
           remote="matonos-dev" revision="matonos/v1.2" />
  <project path="device/maton/pc_x86_64/linux/third_party/libyaml/upstream" name="libyaml"
           remote="matonos-dev" revision="matonos/v1.2" />
</manifest>
