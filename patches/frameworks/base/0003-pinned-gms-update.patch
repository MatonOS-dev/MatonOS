+
+    static boolean isMatonPinnedGmsUpdate(String packageName,
+            SigningDetails installed, SigningDetails incoming) {
+        if (incoming == null || incoming.getSignatures() == null
+                || incoming.getSignatures().length != 1) return false;
+        for (String[] transition : MATON_PINNED_TRANSITIONS) {
+            if (transition[0].equals(packageName)
+                    && hasExactSigner(installed, new String[] {transition[1]})
+                    && incoming.hasAncestorOrSelfWithDigest(java.util.Set.of(transition[2]))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasExactSigner(SigningDetails details, String[] expectedSha256) {
+        if (details == null || details.getSignatures() == null
+                || details.getSignatures().length != 1) return false;
+        try {
+            byte[] hash = java.security.MessageDigest.getInstance("SHA-256")
+                    .digest(details.getSignatures()[0].toByteArray());
+            StringBuilder hex = new StringBuilder(64);
+            for (byte value : hash) hex.append(String.format(java.util.Locale.ROOT,
+                    "%02x", value & 0xff));
+            for (String expected : expectedSha256) {
+                if (expected.equals(hex.toString())) return true;
+            }
+            return false;
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new AssertionError(e);
+        }
+    }
