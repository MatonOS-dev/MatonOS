+package com.android.wm.shell.windowdecor;
+
+import android.app.ActivityManager.RunningTaskInfo;
+import android.content.Context;
+import android.view.ViewGroup;
+
+/** Optional Shell seam for app supplied desktop caption content. */
+public interface DesktopCaptionFactory {
+    /** Adds or updates provider content in the supplied caption slot. */
+    void bindCaption(Context context, ViewGroup slot, RunningTaskInfo taskInfo,
+            WindowDecorationActions actions, int widthPx, int heightPx);
+
+    /** Releases the provider content and any per-task binding. */
+    void unbindCaption(int taskId);
+
+    /** Whether this task draws its own caption and therefore needs a drag-only system strip. */
+    boolean isClientDecorated(RunningTaskInfo taskInfo);
+
+    /** Whether provider content is currently attached for this task. */
+    boolean hasProviderCaption(RunningTaskInfo taskInfo);
+}
