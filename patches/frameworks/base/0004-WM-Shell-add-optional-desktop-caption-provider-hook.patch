+    fun showStatusBarForPointerHover(displayId: Int): Boolean {
+        if (displayId !in statusBarHiddenDisplays) return false
+        val wct = WindowContainerTransaction()
+        if (!setStatusBarVisibilityOverride(
+                wct,
+                displayId,
+                forciblyHidden = false,
+                forciblyShown = true,
+            )
+        ) {
+            return false
+        }
+        shellTaskOrganizer.applyTransaction(wct)
+        return true
+    }
+
+    /** Reasserts the hidden override after a pointer-hover reveal interval. */
+    fun hideStatusBarAfterPointerHover(displayId: Int) {
+        if (displayId !in statusBarHiddenDisplays) return
+        val wct = WindowContainerTransaction()
+        if (setStatusBarVisibilityOverride(wct, displayId, forciblyHidden = true)) {
+            shellTaskOrganizer.applyTransaction(wct)
+        }
+    }
+
+    private fun setStatusBarVisibilityOverride(
+        wct: WindowContainerTransaction,
+        displayId: Int,
+        forciblyHidden: Boolean,
+        forciblyShown: Boolean = false,
+    ): Boolean {
+        val displayToken = rootDisplayAreaOrganizer?.getDisplayTokenForDisplay(displayId)
+        if (displayToken == null) {
+            ProtoLog.w(
+                WM_SHELL_DESKTOP_MODE,
+                "Unable to update immersive status bar visibility: display %d has no token",
+                displayId,
+            )
+            return false
+        }
+        wct.setSystemBarVisibilityOverride(
+            displayToken,
+            systemBarVisibilityOverrideOwner,
+            if (forciblyShown) WindowInsets.Type.statusBars() else 0,
+            if (forciblyHidden) WindowInsets.Type.statusBars() else 0,
+        )
+        return true
+    }
+
