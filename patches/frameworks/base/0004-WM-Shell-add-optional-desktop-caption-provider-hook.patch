+    private void revealImmersiveStatusBarOnTopEdgeHover(MotionEvent ev) {
+        final int action = ev.getActionMasked();
+        if (action != MotionEvent.ACTION_HOVER_MOVE
+                && action != MotionEvent.ACTION_HOVER_ENTER) {
+            return;
+        }
+        if (ev.getRawY() > 2f) {
+            return;
+        }
+
+        final int displayId = ev.getDisplayId();
+        if (!mDesktopImmersiveController.showStatusBarForPointerHover(displayId)) {
+            return;
+        }
+        final Runnable previousCallback = mStatusBarHoverHideCallbacks.get(displayId);
+        if (previousCallback != null) {
+            mMainHandler.removeCallbacks(previousCallback);
+        }
+        final Runnable hideCallback = () ->
+                mDesktopImmersiveController.hideStatusBarAfterPointerHover(displayId);
+        mStatusBarHoverHideCallbacks.put(displayId, hideCallback);
+        mMainHandler.postDelayed(hideCallback, 2500);
+    }
