From f1073c398c040a0ca7f1df10a5a2818de5d7475f Mon Sep 17 00:00:00 2001
From: MatonOS <matonos@localhost>
Date: Sun, 11 Oct 2026 18:22:12 +0200
Subject: [PATCH 1/2] wm: add gated bridge-only per-task client-decoration
 state

Stock transparent captions retain Shell controls. Expose a transient owner-checked override only to MatonOS System Bridge, disabled unless ro.matonos.client_decorations is true. Publish through TaskInfo, without granting framework access to Linux stubs.
---
 core/java/android/app/TaskInfo.java           |  7 ++++
 core/java/android/view/IWindowManager.aidl    |  3 ++
 .../core/java/com/android/server/wm/Task.java |  9 ++++
 .../server/wm/WindowManagerService.java       | 41 +++++++++++++++++++
 4 files changed, 60 insertions(+)

diff --git a/core/java/android/app/TaskInfo.java b/core/java/android/app/TaskInfo.java
index 6215256..f60a733 100644
--- a/core/java/android/app/TaskInfo.java
+++ b/core/java/android/app/TaskInfo.java
@@ -291,6 +291,12 @@ public class TaskInfo {
      */
     public boolean isResizeable;
 
+    /**
+     * MatonOS: client decorations replace the Shell caption.
+     * @hide
+     */
+    public boolean matonosClientDecorated;
+
     /**
      * Minimal width of the task when it's resizeable.
      * @hide
@@ -499,6 +502,7 @@ public class TaskInfo {
                 ? new ActivityInfo(other.topActivityInfo)
                 : null;
         isResizeable = other.isResizeable;
+        matonosClientDecorated = other.matonosClientDecorated;
         minWidth = other.minWidth;
         minHeight = other.minHeight;
         defaultMinSize = other.defaultMinSize;
@@ -653,6 +657,7 @@ public class TaskInfo {
             return false;
         }
         return topActivityType == that.topActivityType
+                && matonosClientDecorated == that.matonosClientDecorated
                 && isResizeable == that.isResizeable
                 && supportsMultiWindow == that.supportsMultiWindow
                 && supportsMultiWindowWithoutConstraints
@@ -743,6 +748,7 @@ public class TaskInfo {
         displayCutoutInsets = source.readTypedObject(Rect.CREATOR);
         topActivityInfo = source.readTypedObject(ActivityInfo.CREATOR);
         isResizeable = source.readBoolean();
+        matonosClientDecorated = source.readBoolean();
         minWidth = source.readInt();
         minHeight = source.readInt();
         defaultMinSize = source.readInt();
@@ -805,6 +811,7 @@ public class TaskInfo {
         dest.writeTypedObject(displayCutoutInsets, flags);
         dest.writeTypedObject(topActivityInfo, flags);
         dest.writeBoolean(isResizeable);
+        dest.writeBoolean(matonosClientDecorated);
         dest.writeInt(minWidth);
         dest.writeInt(minHeight);
         dest.writeInt(defaultMinSize);
diff --git a/core/java/android/view/IWindowManager.aidl b/core/java/android/view/IWindowManager.aidl
