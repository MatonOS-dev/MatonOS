--- a/core/java/android/view/IWindowManager.aidl
+++ b/core/java/android/view/IWindowManager.aidl
@@ -1252,4 +1252,7 @@ interface IWindowManager
      * Returns whether the display with {@code displayId} ignores orientation request.
      */
     boolean getIgnoreOrientationRequest(int displayId);
+
+    /** MatonOS bridge-only, transient self-task client-decoration override. */
+    boolean setMatonosClientDecorated(int taskId, int ownerUid, boolean decorated);
 }
diff --git a/services/core/java/com/android/server/wm/Task.java b/services/core/java/com/android/server/wm/Task.java
index ef60ace..cd588cd 100644
--- a/services/core/java/com/android/server/wm/Task.java
+++ b/services/core/java/com/android/server/wm/Task.java
@@ -3426,6 +3426,10 @@ class Task extends TaskFragment {
      * Fills in a {@link TaskInfo} with information from this task. Note that the base intent in the
      * task info will not include any extras or clip data.
      */
+    // Linux CSD needs no phone caption; there is no per-task stock override.
+    // Never persist this or carry it to a different UID/activity in the task.
+    int mMatonosClientDecorationUid = -1;
+
     void fillTaskInfo(TaskInfo info) {
         fillTaskInfo(info, true /* stripExtras */);
     }
@@ -3448,6 +3452,11 @@ class Task extends TaskFragment {
         info.userId = getUserId();
         info.taskId = mTaskId;
         info.effectiveUid = effectiveUid;
+        info.matonosClientDecorated = android.os.SystemProperties.getBoolean(
+                "ro.matonos.client_decorations", false)
+                && mMatonosClientDecorationUid == effectiveUid && top != null
+                && top.getUid() == effectiveUid
+                && "org.matonos.compositor.stub.StubActivity".equals(top.info.name);
         info.displayId = getDisplayId();
         info.displayAreaFeatureId = tda != null ? tda.mFeatureId : FEATURE_UNDEFINED;
         final Intent baseIntent = getBaseIntent();
diff --git a/services/core/java/com/android/server/wm/WindowManagerService.java b/services/core/java/com/android/server/wm/WindowManagerService.java
index b50c541..3cbf6a5 100644
--- a/services/core/java/com/android/server/wm/WindowManagerService.java
+++ b/services/core/java/com/android/server/wm/WindowManagerService.java
@@ -11547,6 +11547,47 @@ public class WindowManagerService extends IWindowManager.Stub
         });
     }
 
+    /**
+     * Linux client titlebars already contain controls. Public transparent-caption
+     * appearance cannot remove Shell controls, so the bridge owns this narrow hook.
+     * Default off and pinned to the bridge package plus task-management permission.
+     */
+    @Override
+    public boolean setMatonosClientDecorated(int taskId, int ownerUid, boolean decorated) {
+        if (!checkCallingPermission(android.Manifest.permission.MANAGE_ACTIVITY_TASKS,
+                "setMatonosClientDecorated")) {
+            throw new SecurityException("Requires MANAGE_ACTIVITY_TASKS");
+        }
+        try {
+            if (Binder.getCallingUid() != mContext.getPackageManager().getPackageUid(
+                    "org.matonos.systembridge", 0)) {
+                throw new SecurityException("Only MatonOS System Bridge may set client decorations");
+            }
+        } catch (android.content.pm.PackageManager.NameNotFoundException e) {
+            throw new SecurityException("MatonOS System Bridge is absent", e);
+        }
+        if (!android.os.SystemProperties.getBoolean("ro.matonos.client_decorations", false)) {
+            return false;
+        }
+        final long identity = Binder.clearCallingIdentity();
+        try {
+            synchronized (mGlobalLock) {
+                final Task task = mRoot.anyTaskForId(taskId, MATCH_ATTACHED_TASK_ONLY);
+                final ActivityRecord top = task == null ? null : task.getTopNonFinishingActivity();
+                if (task == null || top == null || task.effectiveUid != ownerUid
+                        || top.getUid() != ownerUid || !task.inFreeformWindowingMode()
+                        || !"org.matonos.compositor.stub.StubActivity".equals(top.info.name)) {
+                    return false;
+                }
+                task.mMatonosClientDecorationUid = decorated ? ownerUid : -1;
+                task.dispatchTaskInfoChangedIfNeeded(true /* force */);
+                return true;
+            }
+        } finally {
+            Binder.restoreCallingIdentity(identity);
+        }
+    }
+
     private final class ConfigurationChangeSettingInternalImpl implements
             ConfigurationChangeSetting.ConfigurationChangeSettingInternal {
         @NonNull
