--- a/libfiemap/image_manager.cpp
+++ b/libfiemap/image_manager.cpp
@@ -873,6 +873,31 @@ bool ImageManager::ValidateImageMaps() {
     return true;
 }
 
+bool ImageManager::RebuildImageMaps() {
+    auto metadata = OpenMetadata(metadata_dir_);
+    if (!metadata) {
+        LOG(ERROR) << "Could not open image metadata in " << metadata_dir_;
+        return false;
+    }
+    for (const auto& partition : metadata->partitions) {
+        auto name = GetPartitionName(partition);
+        auto image_path = GetImageHeaderPath(name);
+        auto fiemap = SplitFiemap::Open(image_path);
+        if (fiemap == nullptr || !fiemap->HasPinnedExtents()) {
+            LOG(ERROR) << "Image cannot be remapped: " << image_path;
+            return false;
+        }
+        auto size = android::fs_mgr::GetPartitionSize(*metadata.get(), partition);
+        bool readonly = partition.attributes & LP_PARTITION_ATTR_READONLY;
+        if (!UpdateMetadata(metadata_dir_, name, fiemap.get(), size, readonly)) {
+            LOG(ERROR) << "Could not rewrite extents for " << image_path;
+            return false;
+        }
+        LOG(INFO) << "Rebuilt extents for " << image_path;
+    }
+    return true;
+}
