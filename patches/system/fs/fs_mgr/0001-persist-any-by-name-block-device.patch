diff --git a/libfiemap/utility.cpp b/libfiemap/utility.cpp
index cdd137b3..357651af 100644
--- a/libfiemap/utility.cpp
+++ b/libfiemap/utility.cpp
@@ -16,6 +16,12 @@
 
 #include "utility.h"
 
+#include <algorithm>
+#include <dirent.h>
+#include <memory>
+#include <string>
+#include <vector>
+
 #include <stdint.h>
 #include <sys/stat.h>
 #include <sys/sysmacros.h>
@@ -35,8 +41,6 @@ namespace fiemap {
 using namespace std::string_literals;
 using android::base::unique_fd;
 
-static constexpr char kUserdataDevice[] = "/dev/block/by-name/userdata";
-
 FiemapStatus DetermineMaximumFileSize(const std::string& file_path, uint64_t* result) {
     // Create the smallest file possible (one block).
     FiemapUniquePtr writer;
@@ -79,13 +83,31 @@ FiemapStatus DetermineMaximumFileSize(const std::string& file_path, uint64_t* re
 std::string GetDevicePathForFile(SplitFiemap* file) {
     auto bdev_path = file->bdev_path();
 
-    struct stat userdata, given;
-    if (!stat(bdev_path.c_str(), &given) && !stat(kUserdataDevice, &userdata)) {
-        if (S_ISBLK(given.st_mode) && S_ISBLK(userdata.st_mode) &&
-            given.st_rdev == userdata.st_rdev) {
-            return kUserdataDevice;
+    struct stat given;
+    if (stat(bdev_path.c_str(), &given) || !S_ISBLK(given.st_mode)) {
+        return bdev_path;
+    }
+
+    // A kernel disk name such as sda3 is not stable across boots. Persist the
+    // GPT by-name alias for any partition, not only userdata, when available.
+    std::unique_ptr<DIR, decltype(&closedir)> dir(opendir("/dev/block/by-name"), closedir);
+    if (!dir) return bdev_path;
+
+    std::vector<std::string> matches;
+    struct dirent* entry;
+    while ((entry = readdir(dir.get())) != nullptr) {
+        if (entry->d_name[0] == '.') continue;
+        auto candidate = "/dev/block/by-name/" + std::string(entry->d_name);
+        struct stat candidate_stat;
+        if (!stat(candidate.c_str(), &candidate_stat) && S_ISBLK(candidate_stat.st_mode) &&
+            candidate_stat.st_rdev == given.st_rdev) {
+            matches.emplace_back(candidate);
         }
     }
+    if (!matches.empty()) {
+        std::sort(matches.begin(), matches.end());
+        return matches.front();
+    }
     return bdev_path;
 }
 
diff --git a/libfstab/fstab.cpp b/libfstab/fstab.cpp
index e3e5336f..e322f790 100644
--- a/libfstab/fstab.cpp
+++ b/libfstab/fstab.cpp
@@ -857,7 +857,31 @@ std::string GetBootPartUuid() {
             boot_part_uuid = value;
         }
     });
-
+    if (!boot_part_uuid.empty()) return boot_part_uuid;
+
+    // MatonOS: UKIs carry no per-install cmdline. The boot loader (or
+    // systemd-stub) exports the ESP it started from in LoaderDevicePartUUID:
+    // a 4-byte attribute word followed by a NUL-terminated UTF-16LE GUID.
+    std::string raw;
+    if (!android::base::ReadFileToString(
+                "/sys/firmware/efi/efivars/"
+                "LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f",
+                &raw)) {
+        return "";
+    }
+    for (size_t i = 4; i + 1 < raw.size(); i += 2) {
+        const char c = raw[i];
+        if (c == '\0' && raw[i + 1] == '\0') break;
+        if (raw[i + 1] != '\0' || !(isxdigit(static_cast<unsigned char>(c)) || c == '-')) {
+            LERROR << "Malformed LoaderDevicePartUUID EFI variable";
+            return "";
+        }
+        boot_part_uuid += static_cast<char>(tolower(static_cast<unsigned char>(c)));
+    }
+    if (boot_part_uuid.size() != 36) {
+        LERROR << "Malformed LoaderDevicePartUUID EFI variable: " << boot_part_uuid;
+        return "";
+    }
     return boot_part_uuid;
 }
 
