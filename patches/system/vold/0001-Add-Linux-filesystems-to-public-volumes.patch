+static void CloseFdLogged(int fd, const char* file, int line) {
+    if (close(fd) != 0)
+        PLOG(ERROR) << "close fd=" << fd << " at " << file << ":" << line << " failed";
+}
+#define CLOSE_FD(fd) CloseFdLogged((fd), __FILE__, __LINE__)
+
+// Swap the Linux desktop identity with AID_MEDIA_RW. uid_map/gid_map require
+// one-to-one ranges, so a many-to-one mapping of every filesystem owner cannot
+// be represented; all other owners remain unchanged. (uid_t)-1 stays unmapped.
+static constexpr uint32_t kDesktopId = 1000;
+
+static bool WriteIdMap(const std::string& path) {
+    const uint64_t low = std::min<uint32_t>(kDesktopId, AID_MEDIA_RW);
+    const uint64_t high = std::max<uint32_t>(kDesktopId, AID_MEDIA_RW);
+    const uint64_t end = UINT32_MAX;  // exclusive: ids 0 .. UINT32_MAX-1
+    std::string map;
+    auto append = [&map](uint64_t inside, uint64_t outside, uint64_t count) {
+        if (count != 0)
+            map += StringPrintf("%llu %llu %llu\n", static_cast<unsigned long long>(inside),
+                                static_cast<unsigned long long>(outside),
+                                static_cast<unsigned long long>(count));
+    };
+    append(0, 0, low);
+    append(low, high, 1);
+    append(low + 1, low + 1, high - low - 1);
+    append(high, low, 1);
+    append(high + 1, high + 1, end - high - 1);
+
+    int fd = open(path.c_str(), O_WRONLY | O_CLOEXEC);
+    if (fd < 0) {
+        PLOG(ERROR) << "open " << path << " for idmap failed";
+        return false;
+    }
+    ssize_t rc = TEMP_FAILURE_RETRY(write(fd, map.data(), map.size()));
+    bool ok = rc == static_cast<ssize_t>(map.size());
+    if (!ok) {
+        if (rc >= 0) errno = EIO;
+        PLOG(ERROR) << "write " << path << " idmap failed map=" << map;
+    }
+    CLOSE_FD(fd);
+    return ok;
+}
+
+// The child only creates the user namespace and waits. Maps are written and
+// the mount is cloned/idmapped/attached by vold itself: multi-extent maps must
+// be written from the parent namespace, and mount_setattr/move_mount need
+// CAP_SYS_ADMIN in the initial user namespace.
+static status_t MountIdmapped(const std::string& source, const std::string& target) {
+    int sockets[2];
+    if (socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sockets) != 0) {
+        PLOG(ERROR) << "socketpair for idmapped mount failed source=" << source;
+        return -errno;
+    }
+    pid_t child = fork();
+    if (child < 0) {
+        PLOG(ERROR) << "fork for idmapped mount failed source=" << source;
+        CLOSE_FD(sockets[0]);
+        CLOSE_FD(sockets[1]);
+        return -errno;
+    }
+    if (child == 0) {
+        close(sockets[0]);
+        char byte = unshare(CLONE_NEWUSER) == 0 ? 'U' : 'E';
+        if (byte == 'E') PLOG(ERROR) << "unshare user namespace failed source=" << source;
+        if (TEMP_FAILURE_RETRY(write(sockets[1], &byte, 1)) != 1) _exit(1);
+        // Hold the namespace until vold closes its end.
+        TEMP_FAILURE_RETRY(read(sockets[1], &byte, 1));
+        _exit(0);
+    }
+    CLOSE_FD(sockets[1]);
+
+    status_t result = -EOPNOTSUPP;
+    int usernsFd = -1;
+    int mountFd = -1;
+    char byte = 0;
+    std::string proc = StringPrintf("/proc/%d", child);
+    if (TEMP_FAILURE_RETRY(read(sockets[0], &byte, 1)) != 1 || byte != 'U') {
+        LOG(ERROR) << "idmap child " << child << " failed to create user namespace source="
+                   << source;
+    } else if (!WriteIdMap(proc + "/uid_map") || !WriteIdMap(proc + "/gid_map")) {
+        LOG(ERROR) << "write idmap uid/gid maps failed child=" << child << " source=" << source;
+    } else if ((usernsFd = open((proc + "/ns/user").c_str(), O_RDONLY | O_CLOEXEC)) < 0) {
+        PLOG(ERROR) << "open idmap user namespace failed child=" << child << " source=" << source;
+    } else if ((mountFd = syscall(SYS_open_tree, AT_FDCWD, source.c_str(),
+                                  OPEN_TREE_CLONE | OPEN_TREE_CLOEXEC)) < 0) {
+        PLOG(ERROR) << "open_tree failed source=" << source;
+    } else {
+        struct mount_attr attr = {};
+        attr.attr_set = MOUNT_ATTR_IDMAP;
+        attr.userns_fd = static_cast<uint64_t>(usernsFd);
+        if (syscall(SYS_mount_setattr, mountFd, "", AT_EMPTY_PATH, &attr, sizeof(attr)) != 0) {
+            PLOG(ERROR) << "mount_setattr MOUNT_ATTR_IDMAP failed source=" << source;
+        } else if (syscall(SYS_move_mount, mountFd, "", AT_FDCWD, target.c_str(),
+                           MOVE_MOUNT_F_EMPTY_PATH) != 0) {
+            PLOG(ERROR) << "move_mount failed source=" << source << " target=" << target;
+            result = -errno;
+        } else {
+            result = OK;
+        }
+    }
+    if (mountFd >= 0) CLOSE_FD(mountFd);
+    if (usernsFd >= 0) CLOSE_FD(usernsFd);
+    CLOSE_FD(sockets[0]);
+    int status = 0;
+    if (TEMP_FAILURE_RETRY(waitpid(child, &status, 0)) < 0)
+        PLOG(ERROR) << "waitpid idmap child=" << child << " failed source=" << source;
+    else if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+        LOG(ERROR) << "idmap child=" << child << " exited status=" << status
+                   << " source=" << source;
+    return result;
+}
+
+static bool IsUnixPermissionFs(const std::string& fsType) {
+    return fsType == "ext2" || fsType == "ext3" || fsType == "ext4" || fsType == "btrfs" ||
+           fsType == "xfs" || fsType == "f2fs";
+}
+
+static status_t CheckPublicFilesystem(const std::string& fsType, const std::string& source) {
+    if (fsType == "vfat" || fsType == "exfat") return OK;
+    const char* checker = nullptr;
+    std::vector<std::string> args;
+    if (fsType == "ext2" || fsType == "ext3" || fsType == "ext4") {
+        checker = "/system/bin/e2fsck";
+        args = {checker, "-p", source};
+    } else if (fsType == "f2fs") {
+        checker = "/system/bin/fsck.f2fs";
+        args = {checker, "-a", source};
+    } else {
+        LOG(INFO) << "Skipping filesystem check for " << fsType << " on " << source
+                  << ": no permitted checker is shipped";
+        return OK;
+    }
+    if (access(checker, X_OK) != 0) {
+        LOG(INFO) << "Skipping filesystem check for " << fsType << " on " << source << ": "
+                  << checker << " is not executable in the image";
+        return OK;
+    }
+    int rc = ForkExecvpTimeout(args, kUntrustedFsckSleepTime, sFsckUntrustedContext);
+    if (rc == 0 || (fsType != "f2fs" && rc == 1)) return OK;
+    LOG(ERROR) << "filesystem check failed fs=" << fsType << " source=" << source << " exit=" << rc;
+    return -EIO;
+}
+
+static status_t MountUnixFilesystem(const std::string& fsType, const std::string& source,
+                                    const std::string& target) {
+    // Removable disk: one label for every file; the disk's own xattr labels mean nothing here.
+    const char* data = "context=u:object_r:vfat:s0";
+    unsigned long flags = MS_NOATIME | MS_NODEV | MS_NOSUID | MS_DIRSYNC | MS_NOEXEC;
+    int rc = mount(source.c_str(), target.c_str(), fsType.c_str(), flags, data);
+    if (rc != 0)
+        PLOG(ERROR) << "mount failed fs=" << fsType << " source=" << source << " target=" << target;
+    return rc;
+}
