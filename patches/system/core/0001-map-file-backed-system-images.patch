+bool BlockDevInitializer::HasBootDevicePartition(const std::string& partition_name) {
+    bool found = false;
+    auto callback = [this, &partition_name, &found](const Uevent& uevent) {
+        if (uevent.subsystem != "block") return ListenerAction::kContinue;
+        auto name = uevent.partition_name;
+        if (name.empty()) {
+            const auto slash = uevent.path.rfind('/');
+            name = slash == std::string::npos ? uevent.path : uevent.path.substr(slash + 1);
+        }
+        if (name == partition_name && device_handler_->IsBootDevice(uevent)) {
+            found = true;
+            return ListenerAction::kStop;
+        }
+        return ListenerAction::kContinue;
+    };
+    uevent_listener_.RegenerateUevents(callback);
+    return found;
+}
