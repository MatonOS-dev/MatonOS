+bool FirstStageMountAndroid::WrapImageStore(FstabEntry* entry) {
+    std::string partition;
+    if (!android::base::Realpath(entry->blk_device, &partition)) {
+        PLOG(ERROR) << "realpath failed: " << entry->blk_device;
+        return false;
+    }
+    android::base::unique_fd fd(open(partition.c_str(), O_RDONLY | O_CLOEXEC));
+    uint64_t size = 0;
+    if (fd < 0 || ioctl(fd.get(), BLKGETSIZE64, &size) != 0 || size < 512) {
+        PLOG(ERROR) << "Could not size image store " << partition;
+        return false;
+    }
+    android::dm::DmTable table;
+    table.Emplace<android::dm::DmTargetLinear>(0, size / 512, partition, 0);
+    std::string path;
+    auto& dm = android::dm::DeviceMapper::Instance();
+    if (!dm.CreateDevice("maton_system", table, &path, std::chrono::milliseconds::zero()) ||
+        !block_dev_init_.InitDmDevice(path)) {
+        LOG(ERROR) << "Could not create dm node for image store " << partition;
+        return false;
+    }
+    entry->blk_device = path;
+    return true;
+}
