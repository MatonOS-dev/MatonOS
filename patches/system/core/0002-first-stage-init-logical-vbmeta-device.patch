first-stage init: create dm nodes for logical vbmeta partitions

libfs_avb falls back to the dm device of a logical vbmeta, but first stage
only creates device nodes for entries it mounts. MatonOS keeps vbmeta in
super (live) or a mapped image file (installed).

--- a/init/first_stage_mount.cpp
+++ b/init/first_stage_mount.cpp
@@ -545,6 +545,24 @@
 bool FirstStageMount::InitAvbHandle() {
     if (avb_handle_) return true;  // Returns true if the handle is already initialized.
 
+    // MatonOS keeps vbmeta in a logical partition. libfs_avb falls back to its
+    // dm device, but first stage only creates nodes for mounted entries.
+    const std::string ab_suffix = fs_mgr_get_slot_suffix();
+    for (const auto& partition : vbmeta_partitions_) {
+        for (const auto& entry : fstab_) {
+            if (!entry.fs_mgr_flags.logical ||
+                basename(entry.blk_device.c_str()) != partition + ab_suffix) {
+                continue;
+            }
+            FstabEntry mapped = entry;
+            if (!fs_mgr_update_logical_partition(&mapped) ||
+                !block_dev_init_.InitDmDevice(mapped.blk_device)) {
+                LOG(ERROR) << "Failed to create device for vbmeta partition " << entry.blk_device;
+                return false;
+            }
+        }
+    }
+
     avb_handle_ = AvbHandle::Open();
 
     if (!avb_handle_) {
