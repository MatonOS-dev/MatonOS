--- a/configure.ac
+++ b/configure.ac
@@ -98,10 +98,11 @@
 
 AX_PTHREAD([], [AC_MSG_ERROR("Missing required pthread support")])
 
-# in some cases PTHREAD_LIBS is empty - force -lpthread */
-if test "x$PTHREAD_LIBS" = "x"; then
-	PTHREAD_LIBS="-lpthread"
-fi
+# bionic provides pthread symbols in libc and has no separate libpthread.
+case $host_os in
+  *android*) ;;
+  *) if test "x$PTHREAD_LIBS" = "x"; then PTHREAD_LIBS="-lpthread"; fi ;;
+esac
 
 CFLAGS="$CFLAGS $PTHREAD_CFLAGS"
 LIBS="$LIBS $PTHREAD_LIBS"
