From: MatonOS flatpak-spike
Subject: [PATCH] glib: avoid C23 reserved bool as union member

The Android NDK r30 Clang defaults to gnu23 in this build. Rename the
private union member so it remains a valid identifier in that language mode.

--- a/glib/goption.c
+++ b/glib/goption.c
@@ -56,7 +56,7 @@
   gpointer arg_data;
   union
   {
-    gboolean bool;
+    gboolean bool_value;
     gint integer;
     gchar *str;
     gchar **array;
@@ -1585,7 +1585,7 @@
           switch (change->arg_type)
             {
             case G_OPTION_ARG_NONE:
-              *(gboolean *)change->arg_data = change->prev.bool;
+              *(gboolean *)change->arg_data = change->prev.bool_value;
               break;
             case G_OPTION_ARG_INT:
               *(gint *)change->arg_data = change->prev.integer;
