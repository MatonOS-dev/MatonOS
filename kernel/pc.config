# pc.config: pc_x86_64 kernel fragment.
#
# Merge order (tools/build-kernel.sh), later wins:
#   kernel/base.config        broad distro config: hardware coverage (~6k modules)
#   android-base.config       AOSP kernel/configs requirements
#   kernel/pc.config          this file: Android/boot essentials + overrides
#
# Only things that must differ from a desktop-distro kernel belong here. Don't
# add per-device drivers: the base config already covers hardware broadly.
# Anything needed to reach first-stage mount must be =y (there are no
# first-stage modules); the rest are modules loaded by ueventd via modalias.

# ------------------------------------------------------------- boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# ------------------------------------------------------------- modules
# Android's modprobe/ueventd can't load compressed modules.
# MODULE_SIG is forced on by SECURITY_LOCKDOWN_LSM: modules are signed with a
# key generated at build time (certs/signing_key.pem in the kernel build dir),
# not the distro's. Not enforced yet (no MODULE_SIG_FORCE); see "Protected
# add-on hooks" in NOTES.md.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Kernel Rust needs !MODVERSIONS or GENDWARFKSYMS (which needs debug info).
# Kernel and modules are always built together, so symbol CRCs aren't needed.
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_COMPRESS is not set
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# CONFIG_MODULE_SIG_FORCE is not set
# LoadPin (on in the distro base config) pins module/firmware loads to the
# first filesystem used (/vendor), which would refuse driver add-ons from the
# add-on partition. Module signatures are the trust check instead (user,
# 2026-09-28): MODULE_SIG_FORCE with the MatonOS key once add-ons ship signed.
# CONFIG_SECURITY_LOADPIN is not set

# ------------------------------------------------------------- debug info
# Distro configs carry full DWARF + BTF; that multiplies build time and size.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# ------------------------------------------------------------- storage (built in)
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
# MMC_BLOCK depends on RPMB || !RPMB, so RPMB=m would cap it at m
CONFIG_RPMB=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_BLK_DEV_LOOP=y
# RAM disks for the live image's /data and /metadata (fstab.pc_x86_64.live);
# count/size come from brd.rd_nr / brd.rd_size on the live cmdline.
CONFIG_BLK_DEV_RAM=y

# ------------------------------------------------------------- filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_UNICODE=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y
CONFIG_ZRAM=y

# ------------------------------------------------------------- crypto (no inline crypto engine)
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_CRYPTO_ADIANTUM=y

# ------------------------------------------------------------- Android core
# Rust binder (the rewrite Google ships in Android's own kernels). In
# mainline it replaces the C driver (depends on !ANDROID_BINDER_IPC) and has
# its own binderfs, so ANDROID_BINDERFS (C-only) goes off with it.
# binderfs creates the ANDROID_BINDER_DEVICES nodes at mount time; init.rc
# only symlinks /dev/binder etc. to /dev/binderfs/*, so the list must not be
# empty.
# CONFIG_ANDROID_BINDER_IPC is not set
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_PSI=y
# Android still mounts cgroup v1 blkio, cpu and cpuset (libprocessgroup
# cgroups.json, all required). Since 6.12 the v1 cpuset interface is optional
# and off in distro configs; without it init's SetupCgroups fails and every
# service start fails (first QEMU boot rebooted with bootstrap-apexd-failed).
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,bpf"

# ------------------------------------------------------------- Android networking
# netd still drives legacy iptables; mainline made the legacy tables and the
# extra xt_* matches opt-in, which silently dropped ~50 android-base options.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_INET_DIAG=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_MIRRED=y
# Dependencies of other android-base options (HID_PLAYSTATION, ...)
CONFIG_LEDS_CLASS_MULTICOLOR=y

# ------------------------------------------------------------- firmware
# FW_CACHE stays =y (android-base wants n): nouveau selects it for resume.
# Firmware is staged zstd-compressed (tools/build-kernel.sh).
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ------------------------------------------------------------- display
# Boot framebuffer built in, so there is a display before GPU modules load.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ------------------------------------------------------------- input (built in for early/debug use)
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ------------------------------------------------------------- suspend (s2idle and S3 "deep")
# Android's system_suspend writes "mem" to /sys/power/state; whether that is
# s2idle or deep comes from /sys/power/mem_sleep (firmware default, or the
# mem_sleep_default= cmdline option). Platform drivers (AMD PMC, Intel PMC,
# pinctrl GPIO wake, ...) come from the base config.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_ACPI_SLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_RTC_DRV_CMOS=y

# ------------------------------------------------------------- containers / VMs
# Keeps a future Linux-userspace container or VM possible (NOTES.md).
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_VETH=y
