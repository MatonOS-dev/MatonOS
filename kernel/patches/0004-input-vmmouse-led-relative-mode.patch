input: vmmouse: LED_MISC switches the host to relative mode

Pointer capture with an absolute host pointer turns host positions into
deltas that drift. Userspace sets LED_MISC on the absolute device while
capture is held; the driver then requests relative packets, which the
existing path reports on the relative device.
diff --git a/drivers/input/mouse/vmmouse.c b/drivers/input/mouse/vmmouse.c
index aaecdd3d5..e1687aebc 100644
--- a/drivers/input/mouse/vmmouse.c
+++ b/drivers/input/mouse/vmmouse.c
@@ -388,6 +388,22 @@ static int vmmouse_reconnect(struct psmouse *psmouse)
 	return 0;
 }
 
+/*
+ * LED_MISC on the absolute device asks the host for relative packets, e.g.
+ * while userspace holds pointer capture; the packets arrive on the relative
+ * device.  Off returns to absolute mode.
+ */
+static int vmmouse_abs_event(struct input_dev *dev, unsigned int type,
+			     unsigned int code, int value)
+{
+	if (type != EV_LED || code != LED_MISC)
+		return 0;
+	vmware_hypercall1(VMWARE_CMD_ABSPOINTER_COMMAND,
+			  value ? VMMOUSE_CMD_REQUEST_RELATIVE :
+				  VMMOUSE_CMD_REQUEST_ABSOLUTE);
+	return 0;
+}
+
 /**
  * vmmouse_init - Initialize the vmmouse driver
  *
@@ -442,6 +458,8 @@ int vmmouse_init(struct psmouse *psmouse)
 	input_set_capability(abs_dev, EV_ABS, ABS_Y);
 	input_set_abs_params(abs_dev, ABS_X, 0, VMMOUSE_MAX_X, 0, 0);
 	input_set_abs_params(abs_dev, ABS_Y, 0, VMMOUSE_MAX_Y, 0, 0);
+	input_set_capability(abs_dev, EV_LED, LED_MISC);
+	abs_dev->event = vmmouse_abs_event;
 
 	error = input_register_device(priv->abs_dev);
 	if (error)
