cc_prebuilt_library_shared {
    name: "libpipewire_matonos",
    vendor: true,
    installable: false,
    srcs: ["prebuilt/libpipewire-0.3.so"],
    stem: "libpipewire-0.3",
    strip: {
        none: true,
    },
    export_include_dirs: [
        "prebuilt/include/pipewire-0.3",
        "prebuilt/include/spa-0.2",
    ],
}

cc_binary {
    name: "android.hardware.audio.service-aidl.matonos",
    vendor: true,
    relative_install_path: "hw",
    stem: "matonos-audio-hal",
    defaults: [
        "aidlaudioservice_defaults",
        "latest_android_hardware_audio_core_sounddose_ndk_shared",
        "latest_android_hardware_audio_core_ndk_shared",
        "latest_android_hardware_bluetooth_audio_ndk_shared",
        "latest_android_media_audio_common_types_ndk_shared",
    ],
    srcs: [
        "main.cpp",
        "ModulePipeWire.cpp",
        "AudioControlChannel.cpp",
        "StreamPipeWire.cpp",
    ],
    static_libs: ["libaudioserviceexampleimpl"],
    // ModuleBluetooth calls createIBluetoothAudioProviderFactory in this archive.
    // Drop its unused upstream shared-provider dependency at the final link.
    whole_static_libs: [
        "libmatonos_bluetooth_audio_software",
        "libmatonos_network_speakers",
    ],
    ldflags: ["-Wl,--as-needed"],
    shared_libs: [
        "libaudio_aidl_conversion_common_ndk",
        "libbase",
        "vendor.matonos.channel-V2-ndk",
        "libbluetooth_audio_session_aidl",
        "liblog",
        "libpipewire_matonos",
        "libmedia_helper",
        "libstagefright_foundation",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
