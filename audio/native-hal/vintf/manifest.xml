<manifest version="1.0" type="device">
    <hal format="aidl" override="true">
        <name>android.hardware.audio.core</name>
        <version>4</version>
        <interface>
            <name>IConfig</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IModule</name>
            <instance>default</instance>
            <instance>r_submix</instance>
            <instance>usb</instance>
            <instance>stub</instance>
            <instance>bluetooth</instance>
        </interface>
    </hal>
    <!-- IBluetoothAudioProviderFactory/default: declared by the vendor vintf fragment
         of android.hardware.bluetooth.audio-impl, which the HAL links and registers. -->
</manifest>
