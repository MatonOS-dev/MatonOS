service vendor.audio-hal-aidl /apex/com.matonos.hardware.audio/bin/hw/matonos-audio-hal
    class hal
    disabled
    user audio
    group audio camera media system input
    setenv HOME /data/vendor/maton-audio
    setenv XDG_RUNTIME_DIR /data/vendor/maton-audio
    setenv PIPEWIRE_RUNTIME_DIR /data/vendor/maton-audio
    capabilities BLOCK_SUSPEND SYS_NICE
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    override
    onrestart restart audioserver
