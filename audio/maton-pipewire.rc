on post-fs-data
    mkdir /data/vendor/maton-audio 0770 audio audio
    mkdir /data/vendor/maton-audio/run 0770 audio audio
    mkdir /data/vendor/maton-audio/state 0770 audio audio
    chown audio audio /data/vendor/maton-audio
    chown audio audio /data/vendor/maton-audio/run
    start vendor.maton-pipewire
    start vendor.maton-wireplumber
    start vendor.maton-pipewire-proxy

# PipeWire has no -n option: passing it makes the daemon return -EINVAL
# (process exit status 234), which caused init's rapid restart loop.
service vendor.maton-pipewire /odm/bin/pipewire -c /odm/etc/pipewire/pipewire.conf
    class hal
    user audio
    group audio
    disabled
    setenv LD_LIBRARY_PATH /odm/lib64
    setenv XDG_RUNTIME_DIR /data/vendor/maton-audio/run
    setenv PIPEWIRE_RUNTIME_DIR /data/vendor/maton-audio/run
    setenv PIPEWIRE_CONFIG_DIR /odm/etc/pipewire
    setenv PIPEWIRE_MODULE_DIR /odm/lib64/pipewire-0.3
    setenv SPA_PLUGIN_DIR /odm/lib64/spa-0.2
    setenv ALSA_CONFIG_PATH /odm/etc/alsa/alsa.conf
    setenv ALSA_CONFIG_UCM2 /odm/etc/alsa/ucm2

service vendor.maton-wireplumber /odm/bin/wireplumber -c /odm/etc/wireplumber/wireplumber.conf -p main-embedded
    class hal
    user audio
    group audio
    disabled
    stdio_to_kmsg
    setenv LD_LIBRARY_PATH /odm/lib64
    # This install is rooted at /odm rather than WirePlumber's compiled /usr
    # prefix. Without the data root it cannot find the session scripts and its
    # ALSA monitor never publishes devices (or exits during profile startup).
    setenv WIREPLUMBER_DATA_DIR /odm/share/wireplumber
    setenv WIREPLUMBER_CONFIG_DIR /odm/etc/wireplumber
    setenv XDG_RUNTIME_DIR /data/vendor/maton-audio/run
    setenv PIPEWIRE_RUNTIME_DIR /data/vendor/maton-audio/run
    setenv PIPEWIRE_CONFIG_DIR /odm/etc/pipewire
    setenv HOME /data/vendor/maton-audio
    setenv XDG_STATE_HOME /data/vendor/maton-audio/state
    setenv PIPEWIRE_MODULE_DIR /odm/lib64/pipewire-0.3
    setenv SPA_PLUGIN_DIR /odm/lib64/spa-0.2
    setenv WIREPLUMBER_MODULE_DIR /odm/lib64/wireplumber-0.5
    setenv ALSA_CONFIG_PATH /odm/etc/alsa/alsa.conf
    setenv ALSA_CONFIG_UCM2 /odm/etc/alsa/ucm2

service vendor.maton-pipewire-proxy /odm/bin/maton-pipewire-proxy
    class hal
    user audio
    group audio
    disabled
    setenv LD_LIBRARY_PATH /odm/lib64
    setenv XDG_RUNTIME_DIR /data/vendor/maton-audio/run
    setenv PIPEWIRE_RUNTIME_DIR /data/vendor/maton-audio/run
    setenv PIPEWIRE_CONFIG_DIR /odm/etc/pipewire
    setenv PIPEWIRE_MODULE_DIR /odm/lib64/pipewire-0.3
    setenv SPA_PLUGIN_DIR /odm/lib64/spa-0.2
