# PipeWire is a system-wide ODM service. Audio owns the runtime socket directory.
service vendor.pipewire /apex/com.matonos.hardware.media/bin/pipewire
    class late_start
    disabled
    user audio
    group audio system input
    setenv HOME /data/vendor/maton-audio
    setenv XDG_STATE_HOME /data/vendor/maton-audio/state
    setenv XDG_RUNTIME_DIR /data/vendor/maton-audio
    setenv PIPEWIRE_RUNTIME_DIR /data/vendor/maton-audio
    setenv PIPEWIRE_CONFIG_DIR /apex/com.matonos.hardware.media/etc/pipewire
    setenv PIPEWIRE_MODULE_DIR /apex/com.matonos.hardware.media/lib64/pipewire-0.3
    setenv SPA_PLUGIN_DIR /apex/com.matonos.hardware.media/lib64/spa-0.2
    setenv ALSA_CONFIG_DIR /apex/com.matonos.hardware.media/etc/alsa
    setenv ALSA_CONFIG_PATH /apex/com.matonos.hardware.media/etc/alsa/alsa.conf
    setenv ALSA_CONFIG_UCM2 /apex/com.matonos.hardware.media/etc/alsa/ucm2
    setenv ACP_PATHS_DIR /apex/com.matonos.hardware.media/share/alsa-card-profile/mixer/paths
    setenv ACP_PROFILES_DIR /apex/com.matonos.hardware.media/share/alsa-card-profile/mixer/profile-sets
    setenv LD_LIBRARY_PATH /apex/com.matonos.hardware.media/lib64:/apex/com.matonos.hardware.media/lib64/pipewire-0.3:/apex/com.matonos.hardware.media/lib64/spa-0.2
    capabilities SYS_NICE
    rlimit rtprio 10 10
    task_profiles ProcessCapacityHigh HighPerformance
    onrestart restart vendor.wireplumber


service vendor.wireplumber /apex/com.matonos.hardware.media/bin/wireplumber
    class late_start
    disabled
    user audio
    group audio system input
    setenv HOME /data/vendor/maton-audio
    setenv XDG_STATE_HOME /data/vendor/maton-audio/state
    setenv XDG_RUNTIME_DIR /data/vendor/maton-audio
    setenv PIPEWIRE_RUNTIME_DIR /data/vendor/maton-audio
    setenv PIPEWIRE_CONFIG_DIR /apex/com.matonos.hardware.media/etc/pipewire
    setenv WIREPLUMBER_CONFIG_DIR /apex/com.matonos.hardware.media/etc/wireplumber
    setenv WIREPLUMBER_DATA_DIR /apex/com.matonos.hardware.media/share/wireplumber
    setenv WIREPLUMBER_MODULE_DIR /apex/com.matonos.hardware.media/lib64/wireplumber-0.5
    setenv PIPEWIRE_MODULE_DIR /apex/com.matonos.hardware.media/lib64/pipewire-0.3
    setenv SPA_PLUGIN_DIR /apex/com.matonos.hardware.media/lib64/spa-0.2
    setenv ALSA_CONFIG_DIR /apex/com.matonos.hardware.media/etc/alsa
    setenv ALSA_CONFIG_PATH /apex/com.matonos.hardware.media/etc/alsa/alsa.conf
    setenv ALSA_CONFIG_UCM2 /apex/com.matonos.hardware.media/etc/alsa/ucm2
    setenv ACP_PATHS_DIR /apex/com.matonos.hardware.media/share/alsa-card-profile/mixer/paths
    setenv ACP_PROFILES_DIR /apex/com.matonos.hardware.media/share/alsa-card-profile/mixer/profile-sets
    setenv LD_LIBRARY_PATH /apex/com.matonos.hardware.media/lib64:/apex/com.matonos.hardware.media/lib64/wireplumber-0.5:/apex/com.matonos.hardware.media/lib64/pipewire-0.3:/apex/com.matonos.hardware.media/lib64/spa-0.2
    capabilities SYS_NICE
    rlimit rtprio 10 10
    task_profiles ProcessCapacityHigh HighPerformance
