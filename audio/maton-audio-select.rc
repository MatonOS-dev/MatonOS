# Discover a usable card once at boot. The async oneshot is informational
# configuration only; it never gates the HAL or boot progress.
on post-fs-data
    setprop vendor.maton.audio.selector_done 0
    setprop vendor.maton.audio.selector_result pending
    start vendor.maton-audio-select

on property:vendor.maton.audio.selector_result=found
    setprop persist.vendor.audio.primary.card ${vendor.maton.audio.card}
    setprop persist.vendor.audio.primary.device ${vendor.maton.audio.device}

on property:vendor.maton.audio.selector_result=no_card
    setprop ro.boot.audio.tinyalsa.ignore_output true
    setprop ro.boot.audio.tinyalsa.simulate_input true

# A crash or timeout is also a no-card result. HAL startup proceeds normally.
on property:init.svc.vendor.maton-audio-select=stopped && property:vendor.maton.audio.selector_done=0
    setprop ro.boot.audio.tinyalsa.ignore_output true
    setprop ro.boot.audio.tinyalsa.simulate_input true

service vendor.maton-audio-select /odm/bin/maton-audio-select.sh
    class core
    user root
    group root
    oneshot
    disabled
    timeout_period 3
