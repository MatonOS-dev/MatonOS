# fstab for the pc_x86_64 live image (selected by
# androidboot.fstab_suffix=pc_x86_64.live, see tools/make-live.sh).
#
# system/vendor/... come from the image's own `super` partition; the boot disk
# is found via androidboot.boot_part_uuid. /data and /metadata are RAM disks
# (brd, created by brd.rd_nr=2 on the cmdline) formatted fresh on every boot,
# so nothing persists.
#
# /metadata is not first_stage_mount here: nothing needs it that early (no
# metadata encryption, no OTA snapshots) and the RAM disk nodes only need to
# exist by second-stage mount_all.
#
#<src>             <mnt_point>  <type> <mnt_flags>                         <fs_mgr_flags>
# The live super contains only *_a logical partitions. The live loader entry
# passes androidboot.slot_suffix=_a and keeps the existing live fstab suffix.
system             /system      erofs  ro                                  wait,logical,first_stage_mount,slotselect
system_ext         /system_ext  erofs  ro                                  wait,logical,first_stage_mount,slotselect
product            /product     erofs  ro                                  wait,logical,first_stage_mount,slotselect
vendor             /vendor      erofs  ro                                  wait,logical,first_stage_mount,slotselect
odm                /odm         erofs  ro                                  wait,logical,first_stage_mount,slotselect

/dev/block/ram1    /metadata    ext4   nodev,noatime,nosuid                wait,formattable
/dev/block/ram0    /data        ext4   nodev,noatime,nosuid,errors=panic   latemount,wait,quota,formattable,reservedsize=64M,fileencryption=aes-256-xts:aes-256-cts:v2

/dev/block/zram0   none         swap   defaults                            zramsize=50%

# Removable storage
/devices/*/usb*/*  auto         auto   defaults                            voldmanaged=usb:auto
/devices/*/mmc_host/* auto      auto   defaults                            voldmanaged=sdcard1:auto
