From a0a805598b127214877e8acc493dadf3ca4748ff Mon Sep 17 00:00:00 2001
From: Hanro <hlareman2@gmail.com>
Date: Wed, 30 Sep 2026 21:13:48 +0200
Subject: [PATCH 7/7] drm_hwcomposer: negotiate a scan-out-able client target
 format

SurfaceFlinger always composites the client target as RGBA_8888
(DRM_FORMAT_ABGR8888). Drivers that advertise neither ABGR8888 nor
XBGR8888 on their planes reject it, which previously forced the whole
client target through the copy-to-dumb-buffer fallback.

Emit a composer3 client target property during validate so SurfaceFlinger
renders the client target in a format the display can scan out:
prefer RGBX_8888 (XBGR8888, same bytes as RGBA with alpha ignored), then
BGRA_8888 (ARGB8888), then RGB_565. Nothing is emitted when the default
is supported, so GPU-backed displays are unaffected; where no mapped
alternative exists (e.g. bochs, XRGB8888/BGRX8888 only) the existing
dumb-buffer copy still applies.

Change-Id: I7336fc9ed20c865d336a7dc3ad887c77d36e41e9
---
 hwc/HwcDisplay.cpp         | 61 ++++++++++++++++++++++++++++++++++++++
 hwc/HwcDisplay.h           | 10 +++++++
 hwc3/CommandResultWriter.h | 22 ++++++++++++++
 hwc3/ComposerClient.cpp    | 11 +++++++
 4 files changed, 104 insertions(+)

diff --git a/hwc/HwcDisplay.cpp b/hwc/HwcDisplay.cpp
index 7f3b7ee..f757533 100644
--- a/hwc/HwcDisplay.cpp
+++ b/hwc/HwcDisplay.cpp
@@ -27,6 +27,7 @@
 #include <utils/Trace.h>
 
 #include "backend/BackendManager.h"
+#include "bufferinfo/BufferInfoGetter.h"
 #include "compositor/CompositionPlanner.h"
 #include "compositor/DisplayInfo.h"
 #include "compositor/FlatteningController.h"
@@ -39,6 +40,7 @@
 #include "drm/DrmDisplayPipeline.h"
 #include "drm/DrmFbImporter.h"
 #include "drm/DrmHwc.h"
+#include "drm/DrmPlane.h"
 #include "drm/VSyncWorker.h"
 #include "hwc/HwcLayer.h"
 #include "stats/DisplayConfigurationResultReporter.h"
@@ -1263,6 +1265,65 @@ std::shared_ptr<BindingOwner<DrmPlane>> HwcDisplay::GetCursorPlane() const {
   return pipeline_->GetUsablePlanes().second;
 }
 
+bool HwcDisplay::IsClientTargetFormatSupported(uint32_t drm_format) const {
+  if (!pipeline_) {
+    return false;
+  }
+
+  if (pipeline_->primary_plane &&
+      pipeline_->primary_plane->Get()->IsFormatSupported(drm_format)) {
+    return true;
+  }
+
+  if (!Properties::UseOverlayPlanes() || !pipeline_->crtc) {
+    return false;
+  }
+
+  for (const auto &plane : pipeline_->device->GetPlanes()) {
+    if (plane->GetType() == DRM_PLANE_TYPE_OVERLAY &&
+        plane->IsCrtcSupported(*pipeline_->crtc->Get()) &&
+        plane->IsFormatSupported(drm_format)) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+std::optional<uint32_t> HwcDisplay::GetClientTargetFallbackFormat() const {
+  if (!pipeline_ || !pipeline_->primary_plane) {
+    return std::nullopt;
+  }
+
+  // SurfaceFlinger's default client target format. If the display can scan it
+  // out, leave SurfaceFlinger's choice untouched by not emitting a client
+  // target property at all.
+  if (IsClientTargetFormatSupported(DRM_FORMAT_ABGR8888)) {
+    return std::nullopt;
+  }
+
+  // Alternatives in preference order. RGBX_8888 has the same byte layout as
+  // RGBA_8888 (only the alpha byte is interpreted differently) so it changes
+  // nothing visually; RGB_565 is a last resort that keeps the display working
+  // at reduced color depth.
+  static constexpr uint32_t kFallbackHalFormats[] = {
+      HAL_PIXEL_FORMAT_RGBX_8888,
+      HAL_PIXEL_FORMAT_BGRA_8888,
+      HAL_PIXEL_FORMAT_RGB_565,
+  };
+
+  for (uint32_t hal_format : kFallbackHalFormats) {
+    uint32_t drm_format =
+        LegacyBufferInfoGetter::ConvertHalFormatToDrm(hal_format);
+    if (drm_format != DRM_FORMAT_INVALID &&
+        IsClientTargetFormatSupported(drm_format)) {
+      return hal_format;
+    }
+  }
