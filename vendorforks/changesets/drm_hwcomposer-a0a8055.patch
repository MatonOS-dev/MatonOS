 #include <android/binder_ibinder_platform.h>
 #include <cutils/native_handle.h>
+#include <sync/sync.h>
 #include <ui/GraphicBufferMapper.h>
 #include <utils/Trace.h>
 
@@ -1710,6 +1711,26 @@ void ComposerClient::ExecuteSetDisplayClientTarget(
                                            fence),
                                        command.buffer.slot);
 
+  // The client target is the final, already-composited frame. If the display
+  // KMS driver rejects its dma-buf, copy it to a KMS-local dumb buffer. This
